{
  "name": "aerobim-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node scripts/start-review-shell.mjs",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "lint": "node scripts/lint-ui-strings.mjs",
    "smoke:browser": "node scripts/capture-review-shell-smoke.mjs",
    "smoke:decision": "node scripts/capture-review-decision-smoke.mjs",
    "smoke:demo": "node scripts/capture-demo-seed-smoke.mjs",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1",
    "web-ifc": "^0.0.77"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "jsdom": "^29.0.2",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.11",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
