{
  "name": "aerobim-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "AeroBIM review shell: model, sheet and the expert's decision in one window.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node scripts/start-review-shell.mjs",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "lint": "node scripts/lint-ui-strings.mjs",
    "smoke:browser": "node scripts/capture-review-shell-smoke.mjs",
    "smoke:decision": "node scripts/capture-review-decision-smoke.mjs",
    "smoke:demo": "node scripts/capture-demo-seed-smoke.mjs",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "source-map-js": "1.2.2",
    "three": "^0.186.1",
    "web-ifc": "^0.0.77"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "fflate": "^0.8.3",
    "postcss": "^8.5.10",
    "undici": "^7.30.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  }
}
