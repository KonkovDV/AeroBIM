# AeroBIM — Environment Configuration
# Copy to .env and adjust values for your environment.
# Settings are snapshotted at process start; change env and restart (HD2-DI-02).

AEROBIM_APP_NAME=aerobim-backend
AEROBIM_ENV=development
AEROBIM_HOST=127.0.0.1
AEROBIM_PORT=8080
AEROBIM_STORAGE_DIR=var/reports
AEROBIM_DEBUG=false

# Comma-separated allowed CORS origins.
# If empty, defaults to localhost:3000,5173 only when AEROBIM_DEBUG=true; nothing otherwise.
# AEROBIM_CORS_ORIGINS=https://app.example.com,https://review.example.com

# Optional static API token guard for all /v1 endpoints.
# Required when AEROBIM_ENV is not development/test (fail-closed).
# When using Settings.from_env() without a token, set this OR
# AEROBIM_ALLOW_ANONYMOUS_DEV=true (dev/test only).
# AEROBIM_API_BEARER_TOKEN=replace-with-long-random-token
# AEROBIM_ALLOW_ANONYMOUS_DEV=false

# When true, hard clashes (or failed clash capability) set summary.passed=False.
# AEROBIM_CLASH_AFFECTS_PASS=false

# When true, missing/skipped clash capability is FAILED (no green pass without clash engine).
# Samolet TechLab pilot profile: set BOTH require_clash and clash_affects_pass.
# AEROBIM_REQUIRE_CLASH=false
#
# --- Samolet TechLab pilot profile (recommended for Task 07 packages) ---
# AEROBIM_SIGNOFF_PROFILE=samolet_pilot
# (applies require_clash, clash_affects_pass, require_bsi, require_mep, ACL, audit_fail_closed)
#
# Demo contour for observers (development/test only). Clash/MEP out of scope,
# honest SKIPPED, not faked. Does not close RT-003. LLM egress still forbidden.
# AEROBIM_ENV=development
# AEROBIM_SIGNOFF_PROFILE=samolet_pilot_demo
#
# Moscow AGR 2026 honest-scope contour (development/test only). City CIM AGR
# filing rule from 02.04.2026 (DGP-R-1/26); not a Samolet-signed profile.
# Clash/MEP stay SKIPPED (RT-003 OPEN). LLM egress still forbidden.
# AEROBIM_SIGNOFF_PROFILE=moscow_agr_2026
# Aliases: moscow_agr, agr_2026
# Or set flags individually (explicit env wins over profile defaults):
# AEROBIM_PRIORITY_PROFILE=samolet
# AEROBIM_REQUIRE_CLASH=true
# AEROBIM_CLASH_AFFECTS_PASS=true
# AEROBIM_REQUIRE_BSI_SCHEMA=true
# AEROBIM_REQUIRE_MEP_SYSTEM_CLASH=true
# AEROBIM_AUDIT_FAIL_CLOSED=true
# AEROBIM_CROSS_DOC_SEVERITY=error
# AEROBIM_ENFORCE_OBJECT_ACL=true
# Install clash extra: pip install '.[clash]'
# Still NOT: MEP system-aware clash OK without customer federated scope (RT-003),
# CDE BCF import proof, customer >90% accuracy.
# Checkpoint remains NO_GO until RT-001/002/003.

# Maximum accepted IFC analyze size in bytes (default 256 MiB).
# AEROBIM_MAX_IFC_BYTES=268435456
# Office vs model ingest caps. Dev default = 256 MiB. Under samolet_pilot/production
# the stated Samolet numbers apply (500 MB office / 1.5 GB models) unless:
# AEROBIM_APPLY_SAMOLET_UPLOAD_CAPS=0
# AEROBIM_MAX_OFFICE_BYTES=500000000
# AEROBIM_MAX_MODEL_BYTES=1500000000
# Envelope multipart cap (defaults to max of office/model).
# AEROBIM_MAX_UPLOAD_BYTES=268435456
# Optional per-tenant daily upload quotas (unset = unlimited).
# AEROBIM_MAX_UPLOADS_PER_TENANT_DAY=100
# AEROBIM_MAX_UPLOAD_BYTES_PER_TENANT_DAY=10737418240
# Optional per-tenant cap on QUEUED+RUNNING analyze jobs (unset = unlimited).
# AEROBIM_MAX_CONCURRENT_ANALYZE_JOBS_PER_TENANT=4

# OpenCDE BCF API 3.0 push (optional). Access token from Foundation OAuth2 / hub.
# AEROBIM_BCF_API_BASE_URL=https://hub.example.com/opencde
# AEROBIM_BCF_API_TOKEN=replace-with-hub-access-token
# AEROBIM_BCF_API_PROJECT_ID=F445F4F2-4D02-4B2A-B612-5E456BEF9137
# AEROBIM_BCF_API_VERSION=3.0

# OIDC JWT validation (optional; accepted alongside static bearer). Requires enterprise extra.
# AEROBIM_OIDC_ISSUER=https://idp.example.com/realms/aerobim
# AEROBIM_OIDC_AUDIENCE=aerobim-api
# AEROBIM_OIDC_JWKS_URL=https://idp.example.com/realms/aerobim/protocol/openid-connect/certs
# AEROBIM_OIDC_ROLES_CLAIM=roles
# AEROBIM_OIDC_ROLES_CLAIM=realm_access.roles

# Required outside development/test (durable jobs + shared rate limits).
# Non-dev boot calls require_durable_runtime(): missing Redis is a hard fail.
# Localhost is allowed; Docker/k8s RFC1918 peers are allowed; metadata IPs are not.
# AEROBIM_REDIS_URL=redis://127.0.0.1:6379/0
# Comma-separated reverse-proxy peer IPs that may supply X-Forwarded-For
# for rate-limit keys. Empty = key off the TCP peer only (HD2-RL-03).
# AEROBIM_TRUSTED_PROXY_IPS=10.0.0.1

# --- Advisory LLM (OpenAI-compat). Never sets summary.passed. ---
# Development only. Under AEROBIM_SIGNOFF_PROFILE=samolet_pilot|production egress is hard-disabled.
# Prefer AEROBIM_LLM_ADVISORY_ENABLED. AEROBIM_LLM_LOCAL_ENABLED is deprecated:
# boot logs a warning; remove alias after KT#3 (target 2026-09-21).
# AEROBIM_LLM_ADVISORY_ENABLED=false
# AEROBIM_LLM_LOCAL_ENABLED=false
# AEROBIM_LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# AEROBIM_LLM_API_KEY=
# AEROBIM_LLM_AUTH_SCHEME=Bearer
# AEROBIM_LLM_PROVIDER=yandex-ai-studio
# AEROBIM_LLM_FOLDER_ID=b1g...
# Prefer AEROBIM_LLM_MODEL_REVISION pin. Unversioned Studio URI OK only when catalog
# has no version segment; never write /latest or /rc. Unpinned advisory is not evidence.
# AEROBIM_LLM_MODEL=gpt://b1g.../qwen3.6-35b-a3b
# AEROBIM_LLM_MODEL_REVISION=
# AEROBIM_LLM_KEY_ID=
# Kill-switch: yc iam api-key delete <AEROBIM_LLM_KEY_ID>
# AEROBIM_LLM_MODEL_SHA256=
# AEROBIM_LLM_TIMEOUT_SECONDS=60
# AEROBIM_LLM_MAX_TOKENS_PER_CALL=4096
# AEROBIM_LLM_MAX_TOKENS_PER_RUN=100000
# ~two measured packs (~44k tok/100 findings, think off). Old 250k would not stop a 5-pack loop.
# Day default 300000 — card-bound accounts have no TRIAL_EXPIRED stop.
# AEROBIM_LLM_MAX_TOKENS_PER_DAY=300000
# AEROBIM_LLM_BUDGET_TZ=Europe/Moscow
# Day-roll timezone for max_tokens_per_day (IANA). Required for grant ops with Moscow calendar.
# AEROBIM_LLM_BUDGET_LEDGER=/var/lib/aerobim/llm-budget.json
# REQUIRED when LLM is ready (RT-031 fail-closed). Shared day ledger across workers.
# Without it boot/DI refuses to arm the provider (process-local counters ≈ N× day).
# AEROBIM_LLM_MAX_COMPLETION_TOKENS=512
# Yandex Completions: omit seed (may 400); prefer json_schema; disable vendor data logging.
# Thinking off MUST be chat_template_kwargs.enable_thinking=false (top-level enable_thinking → HTTP 400).
# Provider=yandex-ai-studio auto-defaults: SEND_SEED=false, RESPONSE_FORMAT_MODE=json_schema.
# AEROBIM_LLM_SEND_SEED=false
# AEROBIM_LLM_RESPONSE_FORMAT_MODE=json_schema
# AEROBIM_LLM_DATA_LOGGING_ENABLED=false
# AEROBIM_LLM_MAX_CONCURRENT=4
# AEROBIM_LLM_ADVISORY_MAX_ISSUES=32

# --- Advisory VLM (drawing crop reads). Never sets summary.passed. ---
# Provider-agnostic OpenAI-compat vision (Yandex Qwen, vLLM, or Kimi profile).
# Prefer AEROBIM_VLM_*. AEROBIM_KIMI_* remain deprecated aliases.
# AEROBIM_VLM_ENABLED=false
# AEROBIM_VLM_API_BASE_URL=https://llm.api.cloud.yandex.net/v1
# AEROBIM_VLM_API_KEY=
# AEROBIM_VLM_MODEL=gpt://b1g.../qwen3.6-35b-a3b
# AEROBIM_VLM_REASONING_EFFORT=low
# AEROBIM_VLM_MAX_IMAGE_BYTES=33554432
# AEROBIM_VLM_CACHE_DIR=
# AEROBIM_VLM_CACHE_NAMESPACE=
# AEROBIM_VLM_CACHE_PROJECT=
# AEROBIM_VLM_CACHE_TTL_DAYS=
# Cap for AI remark drafts per analyze (~440 tok/finding; 32≈14k, 100≈44k). Raise after tariff×budget.
# Overlay call path is sequential today; semaphore unused until Sept parallel fan-out.
# AEROBIM_LLM_429_RETRIES=3
# Extra hosts for on-prem Studio / Stackland (comma-separated). Built-in: loopback + ai.api.cloud.yandex.net + llm.api.cloud.yandex.net. Alibaba/OpenAI blocked.
# AEROBIM_LLM_ALLOWED_HOSTS=
# Sample profiles: samples/hybrid/provider-config-qwen-local.json
# AEROBIM_HYBRID_PROVIDER_CONFIG=samples/hybrid/provider-config-qwen-local.json

# Optional buildingSMART IFC Validation Service (remote) or local schema-pack certificate.
# AEROBIM_BSI_VALIDATION_URL=https://dev.validate.buildingsmart.org
# AEROBIM_BSI_API_TOKEN=replace-with-bsi-token
# AEROBIM_BSI_LOCAL_CERT=true

# Remark language for TemplateRemarkGenerator: ru (default) | en
# AEROBIM_REMARK_LOCALE=ru

# Severity emitted for cross-document contradictions detected in multi-source analysis.
# "warning" (default) — contradictions are surfaced but do not set passed=False.
# "error"             — all cross-document contradictions are blocking (delivery gate).
# "info"              — informational only, always non-blocking.
# AEROBIM_CROSS_DOC_SEVERITY=warning

# Default norm/rule pack (customer acceptance-criteria) used when a request/manifest
# does not list norm_rule_pack_paths. Storage-relative path (inside the storage jail).
# If set but the file is missing at analysis time, capabilities.norm_rule_packs fails
# closed (FAILED) instead of a silent skip. Leave unset to skip norm packs by default.
# AEROBIM_NORM_RULE_PACK=uploads/customer/residential-ar-pack.json

# Legal-gated native DWG via ODA/Teigha stub (STUB-ODA-CAD-001). Default off.
# AEROBIM_ODA_CAD_ENABLED=false
#
# Samolet local demo only (never CI / Docker / other customers):
# python -m aerobim.tools.fetch_ifc_bench_v2 --include-gplv3 --samolet-demo-copyleft
# python -m aerobim.tools.run_federated_mep_inventory --samolet-demo-copyleft
# GPLv3 IFC stays in gitignored .local/. LibreDWG is not linked.

# Opt-in system-aware MEP clash (still requires scope memo + IfcSystem). MEP-CLASH-001.
# AEROBIM_MEP_SYSTEM_CLASH_ENABLED=false
# AEROBIM_MEP_SCOPE_MEMO_REF=

# Hybrid drawing analyzer (detector priors + OCR). Vision extra: pip install '.[vision]'.
# Never flips cv_human_level to OK. AEROBIM_HYBRID_DRAWING_ENABLED=true

# Optional IFC parse cache directory for SLA ≤30 min / комплект (NFR).
# AEROBIM_IFC_PARSE_CACHE_DIR=var/ifc-cache

# Optional Postgres summary index for enterprise storage rollout.
# Constructor runs CREATE TABLE + ALTER ADD COLUMN IF NOT EXISTS (HD5-PGSQL-02).
# Pilot: grant DDL. Production: apply migrations out of band, then a DML-only role.
# AEROBIM_DB_URL=postgresql+asyncpg://user:password@localhost:5432/aerobim

# Optional retention policy for persisted reports; leave unset for unlimited retention.
# AEROBIM_REPORT_TTL_DAYS=30

# Optional S3 / MinIO object-store settings.
# AEROBIM_S3_BUCKET=aerobim-artifacts
# AEROBIM_S3_ENDPOINT_URL=http://127.0.0.1:9000
# AEROBIM_S3_REGION=us-east-1
# AEROBIM_S3_ACCESS_KEY_ID=minioadmin
# AEROBIM_S3_SECRET_ACCESS_KEY=minioadmin
# AEROBIM_S3_PREFIX=aerobim
