{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KonkovDV/AeroBIM/samples/profiles/spb-cge/manifest.schema.json",
  "title": "Official published IDS profile manifest (fail-closed)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "profile_id",
    "human_name",
    "language",
    "origin",
    "provenance_status",
    "signed_by_customer",
    "signed_by_customer_reason",
    "samolet_alias",
    "closes_rt001",
    "closes_rt002",
    "closes_rt003",
    "scope",
    "pack_root",
    "ids_schema",
    "files",
    "coverage",
    "disclaimer",
    "related"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact_type": { "const": "official_ids_profile_manifest" },
    "profile_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]*$" },
    "human_name": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization",
        "source_page",
        "source_section",
        "first_published",
        "editions",
        "retrieval_date",
        "retrieval_evidence"
      ],
      "properties": {
        "organization": { "type": "string", "minLength": 1 },
        "source_page": { "type": "string", "pattern": "^https://" },
        "source_section": { "type": "string", "minLength": 1 },
        "first_published": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "editions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject", "edition", "edition_date"],
            "properties": {
              "subject": { "type": "string", "minLength": 1 },
              "edition": { "type": "string", "minLength": 1 },
              "edition_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          }
        },
        "retrieval_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "retrieval_evidence": { "type": "string", "minLength": 1 }
      }
    },
    "provenance_status": { "enum": ["OFFICIAL_PUBLISHED", "DERIVED_UNOFFICIAL"] },
    "signed_by_customer": { "const": false },
    "signed_by_customer_reason": { "type": "string", "minLength": 1 },
    "samolet_alias": { "const": false },
    "closes_rt001": { "const": false },
    "closes_rt002": { "const": false },
    "closes_rt003": { "const": false },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applies_to", "not_applies_to"],
      "properties": {
        "applies_to": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "not_applies_to": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "pack_root": { "type": "string", "minLength": 1 },
    "ids_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "namespace", "xsd_path", "xsd_license"],
      "properties": {
        "version": { "const": "1.0" },
        "namespace": { "const": "http://standards.buildingsmart.org/IDS" },
        "xsd_path": { "type": "string", "minLength": 1 },
        "xsd_license": { "type": "string", "minLength": 1 }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "subject",
          "title",
          "sha256",
          "size_bytes",
          "ids_schema_version",
          "doc_edition"
        ],
        "properties": {
          "path": { "type": "string", "pattern": "^[^\\\\/][^\\\\]*(\\.ids)$" },
          "subject": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "exclusiveMinimum": 0 },
          "ids_schema_version": { "const": "1.0" },
          "doc_edition": { "type": "string", "minLength": 1 }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "does_not_check"],
      "properties": {
        "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "does_not_check": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "disclaimer": { "type": "string", "minLength": 1 },
    "related": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jurisdiction_pointer", "dataset_manifest", "source_md"],
      "properties": {
        "jurisdiction_pointer": { "type": "string", "minLength": 1 },
        "dataset_manifest": { "type": "string", "minLength": 1 },
        "source_md": { "type": "string", "minLength": 1 }
      }
    }
  }
}
