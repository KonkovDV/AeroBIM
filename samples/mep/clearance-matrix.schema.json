{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerobim.dev/schemas/mep-clearance-matrix-1.1.0.json",
  "title": "AeroBIM MEP clearance / system-relation matrix",
  "description": "Customer or template matrix for MEP system-aware rules. Template/synthetic packs cannot close RT-003. Co-presence is not connection proof.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "claim_boundary", "pairs"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0", "1.1.0"]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "claim_boundary": { "type": "string", "minLength": 1 },
    "scope_memo_ref": { "type": ["string", "null"] },
    "approval_ref": { "type": ["string", "null"] },
    "units": { "type": "string", "enum": ["mm", "m"] },
    "default_clearance_mm": { "type": ["number", "null"], "minimum": 0 },
    "synthetic": { "type": "boolean", "default": true },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pair" }
    }
  },
  "$defs": {
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_a", "system_b", "allowed_intersection"],
      "properties": {
        "system_a": { "type": "string", "minLength": 1 },
        "system_b": { "type": "string", "minLength": 1 },
        "system_type": { "type": ["string", "null"] },
        "source_discipline": { "type": ["string", "null"] },
        "target_discipline": { "type": ["string", "null"] },
        "allowed_relation": {
          "type": ["string", "null"],
          "enum": ["forbid_intersection", "require_clearance", "allow", "unclassified", null]
        },
        "allowed_intersection": { "type": "boolean" },
        "min_clearance_mm": { "type": ["number", "null"], "minimum": 0 },
        "zone_or_service_envelope": { "type": ["string", "null"] },
        "severity": {
          "type": ["string", "null"],
          "enum": ["critical", "warning", "info", null]
        },
        "clearance_class": {
          "type": ["string", "null"],
          "enum": ["hard", "soft", "advisory", "unknown", null]
        },
        "source_rule": { "type": ["string", "null"] },
        "approval_reference": { "type": ["string", "null"] },
        "test_case": { "type": ["string", "null"] },
        "expected_result": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] }
      }
    }
  }
}
