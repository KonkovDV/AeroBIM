                        <xs:sequence>
                            <xs:group ref="gChoiceOrganizationtEntrepreneurPerson"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="AuthorNote" type="tNotEmptyString">
                    <xs:annotation>
                        <xs:documentation>Автор в неформализованной форме</xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:choice>
            <xs:element name="Changes" type="tNotEmptyString" minOccurs="0">
