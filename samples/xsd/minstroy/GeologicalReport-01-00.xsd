                    <xs:documentation xml:lang="ru">Класс энергетической эффективности</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="EnergyEfficiencyImproving" type="tTextBlock" minOccurs="0" maxOccurs="1">
