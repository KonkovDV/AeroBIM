<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

    <xs:element name="GeologicalReport">
        <xs:annotation>
            <xs:documentation>Отчет о выполнении инженерных изысканий</xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="CommonInfo" type="tCommonInfo">
                    <xs:annotation>
                        <xs:documentation>Общие сведения</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="TerritorySurveyInformation" type="tTerritoryInformation" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation xml:lang="ru">Сведения о ранее выполненных изысканиях и исследованиях и оценка возможности их использования</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="TerritoryClimateInformation" type="tTerritoryClimateInformation" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation xml:lang="ru">Физико-географические условия района работ и техногенные факторы</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="WorkMetodologyAndTechnology" type="tWorkMetodologyAndTechnology" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation xml:lang="ru">Методика и технология выполнения работ</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="GeologicalSurveysResults" type="tGeologicalSurveysResults" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation xml:lang="ru">Результаты инженерно-геологических изысканий</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="QualityControl" type="tQualityControl" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation xml:lang="ru">Сведения о контроле качества</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="Summary" type="tSummary" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation xml:lang="ru">Рекомендации по результатам инженерных изысканий</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="Appendixes" type="tAppendixes" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation xml:lang="ru">Текстовые приложения</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="GraphicAppendixes" type="tGraphicAppendixes" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation xml:lang="ru">Графические приложения</xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>


    <xs:complexType name="tCommonInfo">
        <xs:annotation>
            <xs:documentation>Общие сведения</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="ObjectInfo" type="tObjectInfo">
                <xs:annotation>
                    <xs:documentation>Сведения от объекте</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Purposes" type="tPurposes" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Цели инженерных изысканий</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Tasks" type="tTasks" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Задачи инженерных изысканий</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="SurveyDates" type="tPeriod" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Сроки выполнения изысканий</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="SurveyReason" type="tDocumentsInfo">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Основание для выполнения изысканий</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="ConstructionType" type="tConstructionType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Вид градостроительной деятельности</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="EngineeringSurveyStage" type="tEngineeringSurveyStage" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Этап выполнения инженерных изысканий</xs:documentation>
                </xs:annotation>
            </xs:element>

            <!-- может ли быть заказчиком поектировщик -->
            <xs:choice minOccurs="1" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>Сведения о заказчике и его роли (застройщик или технический заказчик)</xs:documentation>
                </xs:annotation>
                <xs:element name="Developer" type="tDevelopers">
                    <xs:annotation>
                        <xs:documentation xml:lang="ru">Сведения о застройщике</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="TechnicalCustomer" type="tTechnicalCustomer">
                    <xs:annotation>
                        <xs:documentation xml:lang="ru">Сведения о техническом заказчике</xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:choice>
            <xs:element name="EngineeringSurveyAuthors" type="tEngineeringSurveyAuthors" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Сведения об индивидуальных предпринимателях и (или) юридических лицах, подготовивших отчетную документацию результатов инженерных изысканий</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="LandInfo" type="tLandInfo" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Сведения о земельных участках, категории земель и разрешенном виде использования</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="OverviewScheme" type="tDocumentsInfo" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Обзорная схема района выполнения изысканий</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="tObjectInfo">
        <xs:annotation>
            <xs:documentation>Сведения об объекте</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:choice>
                <xs:element name="Complex" type="tComplexObject" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation xml:lang="ru">Сложный (составной) объект</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="OKS" type="tOKS" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation xml:lang="ru">Объект капитального строительства (простой объект)</xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:choice>
            <xs:choice>
                <xs:element name="ArealObject" type="tArealObject" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation xml:lang="ru">Параметры основного площадного объекта</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="LinearObject" type="tLinearObject" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation xml:lang="ru">Параметры основного линейного объекта</xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:choice>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="tComplexObject">
        <xs:annotation>
            <xs:documentation xml:lang="ru">Часть объекта - сложный объект</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Name" type="tNotEmptyString" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Наименование части объекта</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Placement" type="tPlacement" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Местоположение объекта</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="FunctionsClass" type="tFunctionsClassGroup">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Код классификатора функционального назначения группы объектов капитального строительства</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="FunctionsFeatures" type="tTextBlock" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Принадлежность к объектам транспортной инфраструктуры и к другим объектам, функционально-технологические особенности которых влияют на их безопасность</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="DangerousIndustrialObject" type="tDangerIndustrialClass" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Класс опасности опасного производственного объекта</xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="ObjectParts" type="tObjectParts" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Составные части сложного объекта</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="ObjectID" type="xs:ID" use="required">
            <xs:annotation>
                <xs:documentation xml:lang="ru">Идентификатора объекта (части объекта)</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="ObjectStatus" type="tObjectStatus" use="required">
            <xs:annotation>
                <xs:documentation xml:lang="ru">Статус объекта</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="tOKS">
        <xs:annotation>
            <xs:documentation xml:lang="ru">Описание объекта капитального строительства</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Name" type="tNotEmptyString" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Наименование объекта капитального строительства</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Placement" type="tPlacement" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Местоположение объекта</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:choice>
                <xs:element name="ArealObject" type="tArealOKS" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation xml:lang="ru">Описание площадного объекта</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="LineraObject" type="tLinearOKS" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation xml:lang="ru">Описание линейного объекта</xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:choice>
        </xs:sequence>
        <xs:attribute name="ObjectID" type="xs:ID" use="required">
            <xs:annotation>
                <xs:documentation xml:lang="ru">Идентификатора объекта (части объекта)</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="ObjectStatus" type="tObjectStatus" use="required">
            <xs:annotation>
                <xs:documentation xml:lang="ru">Статус объекта</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="tArealObject">
        <xs:annotation>
            <xs:documentation>Параметры основного площадного объекта</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="PlanSize" type="tAreaPlanSize" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Размеры площадки по генплану</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="ShootingScale" type="tScale" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Масштаб съемки</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="SectionRelief" type="tSectionRelief" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Сечение рельефа, м</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="AdditionalRequirements" type="tTextBlock" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Дополнительные или особые требования</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="tLinearObject">
        <xs:annotation>
            <xs:documentation>Площадной объект капитального строительства</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Length" type="xs:decimal" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Протяженность, км</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="ShootingWidth" type="xs:decimal" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Ширина полосы съемки, м</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="ShootingScale" type="tScale" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Масштаб съемки</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="ScalePlanProfile" type="tScale" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Масштаб плана профиля</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="SectionRelief" type="tSectionRelief" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Сечение рельефа</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="AdditionalRequirements" type="tTextBlock" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Масштаб съемки</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>


    <xs:complexType name="tArealOKS">
        <xs:annotation>
            <xs:documentation xml:lang="ru">Описание объекта капитального строительства</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Name" type="tNotEmptyString" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Наименование площадного объекта капитального строительства</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Placement" type="tPlacement" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Местоположение объекта</xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="ResponsibilityLevel" type="tResponsibilityLevel" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Уровень ответственности</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="FunctionsClass" type="tFunctionsClassOKS" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Код классификатора функционального назначения объектов капитального строительства</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="FunctionsFeatures" type="tTextBlock" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Принадлежность к объектам транспортной инфраструктуры и к другим объектам, функционально-технологические особенности которых влияют на их безопасность</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="EnergyEfficiency" type="tEnergyEfficiency" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Сведения о классе энергетической эффективности (в случае, если присвоение класса энергетической эффективности объекту капитального строительства является обязательным в соответствии с законодательством Российской Федерации об энергосбережении) и о повышении энергетической эффективности</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="DangerousIndustrialObject" type="tDangerIndustrialClass" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Класс опасности опасного производственного объекта</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="FireDangerCategory" type="tFireDangerCategory" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Категория пожарной и взрывопожарной опасности</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="PeoplePermanentStay" type="tTextBlock" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Сведения о наличии помещений с постоянным пребыванием людей</xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="DesignFeatures" type="tTextBlock" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Конструктивные особенности</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="PlanSize" type="tOKSPlanSize" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Размер в плане</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="OverallHeight" type="xs:decimal" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Общая высота, м</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="NumberFloors" type="xs:integer" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Количество этажей</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="ApproximateWeight" type="xs:integer" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Ориентировочная масса, Т</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Foundation" type="tFoundation" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Сведения о фундаменте </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="FoundationPit" type="tFoundationPit" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Сведения о котловане</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Basement" type="xs:decimal" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Глубина подвального помещения</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="StructuresBelowFoundation" type="tTextBlock" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Сведения о конструкциях, расположенных ниже основного фундамента</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Loads" type="tTextBlock" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Предполагаемые статические и динамические нагрузки</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="PermissibleDraft" type="xs:integer" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Допустима осадка проектируемых зданий и сооружений, см</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="tAreaPlanSize">
        <xs:annotation>
            <xs:documentation>Размеры площадки по генплану</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Width" type="xs:decimal" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Ширина</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Length" type="xs:decimal" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Длина</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="tOKSPlanSize">
        <xs:annotation>
            <xs:documentation>Размеры объекта по генплану</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Width" type="xs:decimal" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Ширина</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Length" type="xs:decimal" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Длина</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Height" type="xs:decimal" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Высота</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="tFoundation">
        <xs:annotation>
            <xs:documentation>Сведения о фундаменте</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Type" type="tFoundationType" minOccurs="1" maxOccurs="5">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Тип фундамента</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:choice>
                <xs:element name="SingleMaterial" type="tFoundationMaterial" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation xml:lang="ru">Материал фундамента</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="CombinedMaterial" type="tCombinedFoundationMaterial" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation xml:lang="ru">Комбинированный материал фундамента</xs:documentation>
                    </xs:annotation>
                    <xs:unique name="CombinedFoundationMaterialKey">
                        <xs:selector xpath="Material"/>
                        <xs:field xpath="."/>
                    </xs:unique>
                </xs:element>
            </xs:choice>
