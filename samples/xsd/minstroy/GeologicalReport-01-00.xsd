                    </xs:annotation>
                    <xs:complexType>
                        <xs:simpleContent>
                            <xs:extension base="tNotEmptyString">
                                <xs:attribute name="Name" type="tElementName" use="optional">
                                    <xs:annotation>
                                        <xs:documentation>Именованный элемент</xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                                <xs:attribute name="Id" type="xs:ID" use="optional">
                                    <xs:annotation>
                                        <xs:documentation>Идентификатор элемента</xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                            </xs:extension>
                        </xs:simpleContent>
                    </xs:complexType>
                </xs:element>
                <xs:element name="Image" type="tImage" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation>Изображение</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="Table" type="tTable" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation>Таблица</xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:choice>
        </xs:sequence>
        <xs:attribute name="Title" type="tNotEmptyString" use="optional">
            <xs:annotation>
                <xs:documentation>Заголовок</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="tTable">
        <xs:annotation>
            <xs:documentation>Таблица</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Head" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Заголовок</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Row" type="tRow" minOccurs="1" maxOccurs="unbounded">
                            <xs:annotation>
                                <xs:documentation>Строка</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="Body">
                <xs:annotation>
                    <xs:documentation>Содержимое</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Row" type="tRow" minOccurs="1" maxOccurs="unbounded">
                            <xs:annotation>
                                <xs:documentation>Строка</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="Foot" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Подвал</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Row" type="tRow" minOccurs="1" maxOccurs="unbounded">
                            <xs:annotation>
                                <xs:documentation>Строка</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="Id" type="xs:ID" use="optional">
            <xs:annotation>
                <xs:documentation>Идентификатор таблицы</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="tRow">
        <xs:annotation>
            <xs:documentation>Строка таблицы</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Cell" type="tCell" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="Id" type="xs:ID" use="optional">
            <xs:annotation>
                <xs:documentation>Идентификатор строки</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="Align" type="tAlignTypes" use="optional">
            <xs:annotation>
                <xs:documentation>Выравнивание сведений в строке</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="tCell">
        <xs:annotation>
            <xs:documentation>Ячейка таблицы</xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="Colspan" type="xs:unsignedShort" use="optional">
                    <xs:annotation>
                        <xs:documentation>Объединение столбцов</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="Rowspan" type="xs:unsignedShort" use="optional">
                    <xs:annotation>
                        <xs:documentation>Объединение строк</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="Align" type="tAlignTypes" use="optional">
                    <xs:annotation>
                        <xs:documentation>Выравнивание сведений в ячейке</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="Name" type="tElementName" use="optional">
                    <xs:annotation>
                        <xs:documentation>Именованная ячейка</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="Id" type="xs:ID" use="optional">
                    <xs:annotation>
                        <xs:documentation>Идентификатор ячейки</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:simpleType name="tAlignTypes">
        <xs:annotation>
            <xs:documentation>Варианты выравнивания текста</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="left"/>
            <xs:enumeration value="right"/>
            <xs:enumeration value="center"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="tImage">
        <xs:sequence>
            <xs:element name="ImageData" type="xs:base64Binary">
                <xs:annotation>
                    <xs:documentation>Изображение BASE64</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Comment" type="tNotEmptyString" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Комментарии</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="Type" type="tImageTypes" use="required">
            <xs:annotation>
                <xs:documentation>Тип изображения</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="Name" type="tElementName" use="optional">
            <xs:annotation>
                <xs:documentation>Именованное изображение</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="Id" type="xs:ID" use="optional">
            <xs:annotation>
                <xs:documentation>Идентификатор изображения</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:simpleType name="tImageTypes">
        <xs:annotation>
            <xs:documentation>Типы изображений</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="jpg"/>
            <xs:enumeration value="gif"/>
            <xs:enumeration value="png"/>
            <xs:enumeration value="jpeg"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="tElementName">
        <xs:annotation>
            <xs:documentation>Тип: Идентификатор ячейки</xs:documentation>
        </xs:annotation>
        <xs:restriction base="tNotEmptyString">
            <xs:pattern value="[A-Za-z\-_0-9]+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="tEnergyEfficiency">
        <xs:annotation>
            <xs:documentation xml:lang="ru">Сведения о классе энергетической эффективности (в случае, если присвоение класса энергетической эффективности объекту капитального строительства является обязательным в соответствии с законодательством Российской Федерации об энергосбережении) и о повышении энергетической эффективности</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="EnergyEfficiencyClass" type="tEfficiencyClass" minOccurs="1" maxOccurs="1">
