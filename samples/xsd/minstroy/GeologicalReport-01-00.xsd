            <xs:enumeration value="1:5000"/>
            <xs:enumeration value="1:2000"/>
            <xs:enumeration value="1:1000"/>
            <xs:enumeration value="1:500"/>
            <xs:enumeration value="1:200"/>
            <xs:enumeration value="1:100"/>
            <xs:enumeration value="1:50"/>
