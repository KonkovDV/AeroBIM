		<xs:annotation>
			<xs:documentation xml:lang="ru">Кадастровый номер квартала</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="\d+:\d+:\d+"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tFileName">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Текстовая строка длиной до 255 символов - имя файла</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:normalizedString">
			<xs:maxLength value="255"/>
			<xs:pattern value="(\s*[^\s]\s*)+"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tEmail">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Текстовая строка - адрес электронной почты</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:normalizedString">
			<xs:pattern value="[a-zA-Zа-яА-Я0-9_.\-]{1,}[@]{1}[a-zA-Zа-яА-Я0-9_.\-]{1,}[.]{1}[a-zA-Zа-яА-Я]{2,}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tFunctionsClass">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Код классификатора функционального назначения объектов капитального строительства</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="([0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,3}\.[0-9]{1,3})|([0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,3})"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tFunctionsClassGroup">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Код классификатора функционального назначения группы объектов капитального строительства</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,3}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tFunctionsClassOKS">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Код классификатора функционального назначения объектов капитального строительства</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,3}\.[0-9]{1,3}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tOGRN">
		<xs:annotation>
			<xs:documentation xml:lang="ru">ОГРН организации</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:normalizedString">
			<xs:length value="13"/>
			<xs:pattern value="\d{13}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tINN">
		<xs:annotation>
			<xs:documentation xml:lang="ru">ИНН организации</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:normalizedString">
			<xs:length value="10"/>
			<xs:pattern value="\d{10}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tKPP">
		<xs:annotation>
			<xs:documentation xml:lang="ru">КПП организации</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:normalizedString">
			<xs:length value="9"/>
			<xs:pattern value="\d{9}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tOGRNIP">
		<xs:annotation>
			<xs:documentation xml:lang="ru">ОГРНИП</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:normalizedString">
			<xs:length value="15"/>
			<xs:pattern value="\d{15}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tSNILS">
		<xs:annotation>
			<xs:documentation xml:lang="ru">СНИЛС</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:normalizedString">
			<xs:pattern value="[0-9]{3}-[0-9]{3}-[0-9]{3} [0-9]{2}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tPostIndex">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Почтовый индекс</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:normalizedString">
			<xs:length value="6"/>
			<xs:pattern value="\d{6}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tFileFormat">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Текстовая строка длиной 4 символа</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="4"/>
			<xs:pattern value="(\s*[^\s]\s*)+"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tFileChecksum">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Текстовая строка длиной 8 символов</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9a-fA-F]{8}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tYesNo">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Непустая текстовая строка, содержащая одно из значений "да" или "нет"</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="да">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Логическое значение "да"/"истина"</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="нет">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Логическое значение "нет"/"ложь"</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tYear">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Год</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="2021"/>
			<xs:maxInclusive value="9999"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tGUID">
		<xs:annotation>
			<xs:documentation>Уникальный идентификатор формирования заключения</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tNotEmptyString">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Непустая текстовая строка</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="(\s*[^\s]\s*)+"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:attribute name="KSIcode" type="tNotEmptyString">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Код элемента по КСИ</xs:documentation>
		</xs:annotation>
	</xs:attribute>
	<xs:attribute name="ObjectID" type="xs:ID">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Идентификатор объекта (части объекта)</xs:documentation>
		</xs:annotation>
	</xs:attribute>
	<xs:attribute name="ObjectIDREFS" type="xs:IDREFS">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Ссылки на объект (части объекта)</xs:documentation>
		</xs:annotation>
	</xs:attribute>
	<xs:attribute name="DangerousAndComplex" type="tDangerousAndComplex">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Сведения об отнесении объекта капитального строительства к особо опасным и технически сложным объектам (номер подпункта части 1 статьи 48.1 Градостроительного кодекса Российской Федерации)</xs:documentation>
		</xs:annotation>
	</xs:attribute>
	<xs:attribute name="Unique" type="tUnique">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Сведения об отнесении объекта капитального строительства к уникальным объектам (номер подпункта части 2 статьи 48.1 Градостроительного кодекса Российской Федерации)</xs:documentation>
		</xs:annotation>
	</xs:attribute>

