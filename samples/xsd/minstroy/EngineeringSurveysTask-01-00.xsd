<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
	<!-- Основной элемент -->
	<xs:element name="EngineeringSurveysTask">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Корневой элемент - задание на выполнение инженерных изысканий</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ExerciseSurveyNumber" type="tNotEmptyString" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Шифр задания на инженерные изыскания</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="SecurityLabel" type="tNotEmptyString" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Гриф доступа к документу</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="ExerciseSurveyYear" type="tYear" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Год составления задания на инженерные изыскания</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Modifications" type="tModifications" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Сведения о внесенных изменениях в задания на выполнение инженерные изыскания</xs:documentation>
					</xs:annotation>
					<xs:unique name="ModificationUniqueKey">
						<xs:annotation>
							<xs:documentation>Ключ для контроля повторения номера изменения</xs:documentation>
						</xs:annotation>
						<xs:selector xpath="Modification"/>
						<xs:field xpath="Number"/>
					</xs:unique>
				</xs:element>
				<xs:element name="ObjectInfo" type="tObjectInfo" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Сведения об объекте</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="SurveysInitiationDocuments" type="tDocumentsInfo" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Документы - основание для выполнения работ</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="ConstructionType" type="tConstructionType" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Вид градостроительной деятельности</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="EngineeringSurveyTimePeriod" type="tNotEmptyString" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Сведения о сроках выполнения работ по ИИ, проектирования и эксплуатации объект</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:choice minOccurs="1" maxOccurs="unbounded">
					<xs:element name="Developer" type="tDevelopers">
						<xs:annotation>
							<xs:documentation xml:lang="ru">Сведения о застройщике</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TechnicalCustomer" type="tTechnicalCustomer">
						<xs:annotation>
							<xs:documentation xml:lang="ru">Сведения о техническом заказчике</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:choice>
				<xs:element name="IssueAuthor" type="tAuthor" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Сведения о лице, подготовившем задание на инженерные изыскания – генеральном проектировщике</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Researchers" type="tResearchers" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Сведения о лицах, заключивших договоры на выполнение инженерных изысканий</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Purposes" type="tPurposes" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Цели инженерных изысканий</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Tasks" type="tTasks" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Задачи инженерных изысканий</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="EngineeringSurveyStage" type="tEngineeringSurveyStage" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Этап выполнения инженерных изысканий</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="EngineeringSurveyTypes" type="tEngineeringSurveyTypes" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Виды необходимых инженерных изысканий</xs:documentation>
					</xs:annotation>
					<xs:unique name="BasicEngineeringSurveyTypeKey">
						<xs:selector xpath="BasicEngineeringSurvey/BasicEngineeringSurveyType"/>
						<xs:field xpath="."/>
					</xs:unique>
					<xs:unique name="SpecialEngineeringSurveyTypeKey">
						<xs:selector xpath="SpecialEngineeringSurvey/SpecialEngineeringSurveyType"/>
						<xs:field xpath="."/>
					</xs:unique>
				</xs:element>
				<xs:element name="TechnogenicImpacts" type="tTextBlock" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Предполагаемые техногенные воздействия объекта на окружающую среду</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Ecology" type="tEcology" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Описание экологической обстановки</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="BoundariesArealLinear" type="tBoundariesArealLinear" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Данные о границах площадки (площадок) и (или) трассы (трасс) линейного сооружения (точки ее начала и окончания, протяженность)</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="DangerousNaturalProcesses" type="tDangerousNaturalProcessesSoils" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Наличие предполагаемых опасных природных процессов и явлений, многолетнемерзлых и специфических грунтов на территории расположения объекта</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Requirements" type="tRequirements" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Требования к выполнению изысканий</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="AvailableDocuments" type="tDocumentsInfo" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Документы, прилагаемые к заданию на проведение инженерных изысканий</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!-- Конец описания основного элемента -->

	<!-- Описание сложных типов -->

	<xs:complexType name="tPlacement">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Местоположение объекта</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Address" type="tAddress" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Адрес объекта</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CadastralAreas" type="tCadastralAreas" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Кадастровые кварталы и/или участки</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Areas" type="tAreas" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Координаты участков</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="tCadastralAreas">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Кадастровые кварталы и/или участки</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CadastralDistrict" type="tCadastralDistrictNumber" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Номер кадастрового квартала</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CadastralSite" type="tCadastralSiteNumber" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Номер кадастрового участка</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="tAreas">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Координаты участков</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Area" type="tArea" minOccurs="1" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Координаты участка</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="tArea">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Координаты участка</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CoordinateAndHeightSystem" type="tCoordinateAndHeightSystems" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Системы координат и высот</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Point" type="tPoint" minOccurs="1" maxOccurs="unbounded" fixed="">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Точка координат</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="Name" use="optional" type="tNotEmptyString">
			<xs:annotation>
				<xs:documentation xml:lang="ru">Номер, идентификатор или наименование участка</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		
	</xs:complexType>

	<xs:complexType name="tPoint">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Координатная точка</xs:documentation>
		</xs:annotation>
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attribute name="CoordinateX" type="xs:decimal" use="required">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Координата X</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="CoordinateY" type="xs:decimal" use="required">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Координата Y</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>

	<xs:complexType name="tPurposes">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Цели инженерных изысканий</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Purpose" type="tNotEmptyString" minOccurs="1" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Цель</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="tTasks">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Задачи инженерных изысканий</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Task" type="tNotEmptyString" minOccurs="1" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Задача</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	
		<xs:complexType name="tObjectInfo">
		<xs:annotation>
			<xs:documentation>Сведения об объекте</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:choice>
				<xs:element name="ComplexObject" type="tComplexObject" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Сложный (составной) объект</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="OKS" type="tOKS" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Объект капитального строительства (простой объект)</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:choice>
			<xs:choice>
				<xs:element name="ArealObject" type="tArealObject" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Параметры основного площадного объекта</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="LinearObject" type="tLinearObject" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Параметры основного линейного объекта</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>
	
		<xs:complexType name="tComplexObject">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Часть объекта - сложный объект</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Name" type="tNotEmptyString" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Наименование части объекта</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Placement" type="tPlacement" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Местоположение объекта</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FunctionsClass" type="tFunctionsClassGroup">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Код классификатора функционального назначения группы объектов капитального строительства</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FunctionsFeatures" type="tNotEmptyString" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Принадлежность к объектам транспортной инфраструктуры и к другим объектам, функционально-технологические особенности которых влияют на их безопасность</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DangerousIndustrialObject" type="tDangerIndustrialClass" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Класс опасности опасного производственного объекта</xs:documentation>
				</xs:annotation>
			</xs:element>

			<xs:element name="ObjectParts" type="tObjectParts" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Составные части сложного объекта</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="ObjectID" type="xs:ID" use="required">
			<xs:annotation>
				<xs:documentation xml:lang="ru">Идентификатора объекта (части объекта)</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="ObjectStatus" type="tObjectStatus" use="required">
			<xs:annotation>
				<xs:documentation xml:lang="ru">Статус объекта</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="tOKS">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Описание объекта капитального строительства</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:choice>
				<xs:element name="ArealOKS" type="tArealOKS" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Описание площадного объекта</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="LineraOKS" type="tLinearOKS" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Описание линейного объекта</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:choice>
		</xs:sequence>
		<xs:attribute name="ObjectID" type="xs:ID" use="required">
			<xs:annotation>
				<xs:documentation xml:lang="ru">Идентификатора объекта</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="ObjectStatus" type="tObjectStatus" use="required">
			<xs:annotation>
				<xs:documentation xml:lang="ru">Статус объекта</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="tArealObject">
		<xs:annotation>
			<xs:documentation>Параметры основного площадного объекта</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PlanSize" type="tAreaPlanSize" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Размеры площадки по генплану</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ShootingScale" type="tScale" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Масштаб съемки</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SectionRelief" type="tSectionRelief" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Сечение рельефа, м</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AdditionalRequirements" type="tTextBlock" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Дополнительные или особые требования</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="tLinearObject">
		<xs:annotation>
			<xs:documentation>Параметры основного линейного объекта</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Length" type="xs:decimal" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Протяженность, км</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ShootingWidth" type="xs:decimal" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Ширина полосы съемки, м</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ShootingScale" type="tScale" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Масштаб съемки</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ScalePlanProfile" type="tScale" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Масштаб плана профиля</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SectionRelief" type="tSectionRelief" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Сечение рельефа, м</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AdditionalRequirements" type="tTextBlock" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Дополнительные или особые требования</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="tObjectParts">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Описание частей объекта</xs:documentation>
		</xs:annotation>
		<xs:choice minOccurs="1" maxOccurs="unbounded">
			<xs:element name="ComplexObject" type="tComplexObject">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Сложный (составной) объект</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OKS" type="tOKS">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Объект капитального строительства (простой объект)</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>

	<xs:complexType name="tRequirements">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Требования к выполнению изысканий</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ScientificSupport" type="tTextBlock" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Требование о необходимости научного сопровождения инженерных изысканий (для объектов повышенного уровня ответственности, а также для объектов нормального уровня ответственности, строительство которых планируется на территории со сложными природными и техногенными условиями) и проведения дополнительных исследований, не предусмотренных требованиями нормативных документов (НД) обязательного применения (в случае, если такое требование предъявляется)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AccuracySecurity" type="tTextBlock" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Требования к точности и обеспеченности необходимых данных и характеристик при инженерных изысканиях, превышающие предусмотренные требованиями НД обязательного применения (в случае, если такие требования предъявляются)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ForecastСhangesТaturalСonditions" type="tTextBlock" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Требования к составлению прогноза изменения природных условий</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SuggestionsRecommendation" type="tTextBlock" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Требования о подготовке предложений и рекомендаций для принятия решений по организации инженерной защиты территории, зданий и сооружений от опасных природных процессов и техногенных воздействий и устранению или ослаблению их влияния</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ControlQuality " type="tControlQuality" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Требования по обеспечению контроля качества при выполнении инженерных изысканий</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CompositionOrderTransfer " type="tTextBlock" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Требования к составу, форме и формату предоставления результатов инженерных изысканий, порядку их передачи заказчику</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ArchivalMaterials " type="tDocumentsInfo" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Перечень передаваемых заказчиком во временное пользование исполнителю инженерных изысканий, результатов ранее выполненных инженерных изысканий и исследований, данных о наблюдавшихся на территории инженерных изысканий осложнениях в процессе строительства и эксплуатации сооружений, в том числе деформациях и аварийных ситуациях</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ModelFormat" type="tTextBlock" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Требования к форме предоставления результатов инженерных изысканий, позволяющей осуществлять их использование при формировании и ведении информационной модели (при необходимости)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UsedNorms" type="tUsedNorms" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Перечень нормативных правовых актов, НД, в соответствии с требованиями которых необходимо выполнять инженерные изыскания</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	
