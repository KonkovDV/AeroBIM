	<xs:simpleType name="tCyrillicFIO">
		<xs:annotation>
			<xs:documentation>Фамилия, имя, отчество в кириллице</xs:documentation>
		</xs:annotation>
		<xs:restriction base="tNotEmptyString">
			<xs:pattern value="[а-яА-ЯёЁ\-\s]+"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tPilesCross">
		<xs:annotation>
			<xs:documentation>Сведения о сечении свай, мм</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{1,5}х[0-9]{1,5}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tRAFP">
		<xs:annotation>
			<xs:documentation>Номер записи об аккредитации (НЗА) государственного реестра аккредитованных филиалов, представительств иностранных юридических лиц (РАФП)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:normalizedString">
			<xs:length value="11"/>
			<xs:pattern value="\d{11}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tINNIP">
		<xs:annotation>
			<xs:documentation>ИНН</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:length value="12"/>
			<xs:pattern value="\d{12}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tSchemaVersion">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Номер версии, использованной при формировании пояснительной записки в формате xx.xx</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="([0-9]){2}\.([0-9]){2}"/>
		</xs:restriction>
	</xs:simpleType>

