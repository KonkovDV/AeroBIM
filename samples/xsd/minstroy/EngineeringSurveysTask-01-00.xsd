					</xs:annotation>
				</xs:element>
				<xs:element name="Local" type="tLocalCoordinateSystem">
					<xs:annotation>
						<xs:documentation>Локальная система координат и система высот</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:choice>	
	</xs:complexType>
	
	<xs:complexType name="tInternationalCoordinateSystem">
		<xs:annotation>
