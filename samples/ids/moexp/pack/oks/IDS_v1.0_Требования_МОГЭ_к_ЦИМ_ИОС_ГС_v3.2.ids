    <ids:specification ifcVersion="IFC4" name="ИОС.ГС.6.8.3 Оборудование. Пункты&#xA;редуцирования газа" identifier="6.8.3" description="Требования к ЦИМ. Раздел 6.8.3 Оборудование. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:property dataType="IFCTEXT">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Hh][Qq][Aa][Ll])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:applicability>
