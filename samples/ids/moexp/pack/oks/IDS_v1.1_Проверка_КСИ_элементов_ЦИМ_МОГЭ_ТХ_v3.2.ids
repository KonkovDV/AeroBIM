<?xml version='1.0' encoding='utf-8'?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <ids:info>
    <ids:title>Требования к элементам ТХ ЦИМ ОКС</ids:title>
    <ids:copyright>Отдел ЦИМ, ГАУ МО "Мособлгосэкспертиза"</ids:copyright>
    <ids:version>1.1</ids:version>
    <ids:description>МОГЭ.ЦИМ.ТХ.3.2</ids:description>
    <ids:author>bimmoexp@gmail.com</ids:author>
    <ids:date>2026-03-16</ids:date>
    <ids:purpose>Проверка классификации КСИ элементов ЦИМ по требованиям ГАУ МО «Мособлгосэкспертиза»</ids:purpose>
    <ids:milestone>Проектирование</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification ifcVersion="IFC4" name="ТХ.7.2.1 Мебель" identifier="7.2.1.1" description="Требования к ЦИМ. Раздел 7.2.1 Мебель / Оборудование. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCFURNITURE" /><xs:enumeration value="IFCFURNITURETYPE" /></xs:restriction></ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Cc][Aa][Aa]|[Cc][Bb][Aa]|[Cc][Cc][Aa]|[Cc][Ff][Aa]|[Cc][Ll][Aa]|[Cc][Ll][Bb]|[Cc][Ll][Cc]|[Cc][Ll][Dd]|[Cc][Ll][Ee]|[Cc][Ll][Ff]|[Cc][Ll][Gg]|[Cc][Ll][Hh]|[Cc][Ll][Jj]|[Cc][Mm][Aa]|[Cc][Mm][Bb]|[Cc][Mm][Cc]|[Cc][Nn][Aa]|[Cc][Nn][Bb]|[Cc][Nn][Cc]|[Cc][Pp][Aa]|[Cc][Pp][Bb]|[Cc][Pp][Cc]|[Cc][Pp][Dd]|[Cc][Qq][Aa]|[Cc][Qq][Bb]|[Cc][Qq][Cc])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="ТХ.7.2.1 Зоны обслуживания" identifier="7.2.1.3" description="Требования к ЦИМ. Раздел 7.2.1 Мебель / Оборудование. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCBUILDINGELEMENTPROXY" /><xs:enumeration value="IFCBUILDINGELEMENTPROXYTYPE" /></xs:restriction></ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Dd][Cc])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
  </ids:specifications>
</ids:ids>