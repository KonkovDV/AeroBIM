    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="АР.4.2.4 Кровля. Элементы сборки" identifier="4.2.4.2" description="Требования к ЦИМ. Раздел 4.2.4 Кровля. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
