    <ids:specification ifcVersion="IFC4" name="АР.4.2.5.1 Двери" identifier="4.2.5.1.1" description="Требования к ЦИМ. Раздел 4.2.5.1 Двери / Люки. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
