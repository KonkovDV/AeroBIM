    <ids:specification ifcVersion="IFC4" name="АР.4.2.7 Витражи / Сборные перегородки. Элементы сборки" identifier="4.2.7.2" description="Требования к ЦИМ. Раздел 4.2.7 Витражи / Сборные перегородки. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCWINDOW" /><xs:enumeration value="IFCDOOR" /><xs:enumeration value="IFCPLATE" /><xs:enumeration value="IFCMEMBER" /><xs:enumeration value="IFCELEMENTASSEMBLY" /><xs:enumeration value="IFCWINDOWTYPE" /><xs:enumeration value="IFCDOORTYPE" /><xs:enumeration value="IFCPLATETYPE" /><xs:enumeration value="IFCMEMBERTYPE" /><xs:enumeration value="IFCELEMENTASSEMBLYTYPE" /></xs:restriction></ids:name>
