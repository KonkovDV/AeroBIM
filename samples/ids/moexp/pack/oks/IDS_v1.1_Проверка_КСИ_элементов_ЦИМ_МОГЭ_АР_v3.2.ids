    <ids:specification ifcVersion="IFC4" name="АР.4.2.8 Фасады. Элементы сборки" identifier="4.2.8.2" description="Требования к ЦИМ. Раздел 4.2.8 Фасады. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCPLATE" /><xs:enumeration value="IFCDOOR" /><xs:enumeration value="IFCOPENINGELEMENT" /><xs:enumeration value="IFCWINDOW" /><xs:enumeration value="IFCPLATETYPE" /><xs:enumeration value="IFCDOORTYPE" /><xs:enumeration value="IFCWINDOWTYPE" /></xs:restriction></ids:name>
        </ids:entity>
        </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Nn][Aa][Aa]|[Qq][Qq][Cc]|[Nn][Aa][Bb]|[Xx][Tt][Bb])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="АР.4.2.9 Лестницы / Пандусы. Общая сборка" identifier="4.2.9.1" description="Требования к ЦИМ. Раздел 4.2.9 Лестницы / Пандусы. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCSTAIR" /><xs:enumeration value="IFCRAMP" /><xs:enumeration value="IFCSTAIRTYPE" /><xs:enumeration value="IFCRAMPTYPE" /></xs:restriction></ids:name>
        </ids:entity>
        </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT">
          <ids:propertySet>
            <ids:simpleValue>.*[КкKk][СсCc][ИиIi].*</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>.*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Xx][Ss][Cc]|[Xx][Ss][Dd])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="АР.4.2.9 Лестницы / Пандусы. Элементы сборки" identifier="4.2.9.2" description="Требования к ЦИМ. Раздел 4.2.9 Лестницы / Пандусы. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCCOVERING" /><xs:enumeration value="IFCMEMBER" /><xs:enumeration value="IFCRAILING" /><xs:enumeration value="IFCCOVERINGTYPE" /><xs:enumeration value="IFCMEMBERTYPE" /><xs:enumeration value="IFCRAILINGTYPE" /></xs:restriction></ids:name>
        </ids:entity>
        </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT">
          <ids:propertySet>
            <ids:simpleValue>.*[КкKk][СсCc][ИиIi].*</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>.*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Nn][Cc][Cc]|[Rr][Uu][Aa]|[Uu][Aa][Dd])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="АР.4.2.10 Защитные ограждения" identifier="4.2.10" description="Требования к ЦИМ. Раздел 4.2.10 Защитные ограждения. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCRAILING" /><xs:enumeration value="IFCRAILINGTYPE" /></xs:restriction></ids:name>
        </ids:entity>
        </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*[Ff][Qq][Dd]\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="АР.4.2.11 Помещения" identifier="4.2.11" description="Требования к ЦИМ. Раздел 4.2.11 Помещения. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCSPACE" /><xs:enumeration value="IFCSPACETYPE" /></xs:restriction></ids:name>
        </ids:entity>
        </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([A-Za-zА-Яа-я][A-Za-zА-Яа-я][A-Za-zА-Яа-я])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="АР.4.2.12 Вертикальный транспорт" identifier="4.2.12" description="Требования к ЦИМ. Раздел 4.2.12 Вертикальный транспорт. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
