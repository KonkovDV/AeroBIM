    <ids:specification ifcVersion="IFC4" name="АР.4.2.5.3 Подоконники / отливы" identifier="4.2.5.3" description="Требования к ЦИМ. Раздел 4.2.5.3 Подоконники / отливы. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
