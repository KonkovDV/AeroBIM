<ids:ids xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd" xmlns:ids="http://standards.buildingsmart.org/IDS">
  <ids:info>
    <ids:title>Требования к элементам ПЗУ ЦИМ ОКС</ids:title>
    <ids:copyright>Отдел ЦИМ, ГАУ МО "Мособлгосэкспертиза"</ids:copyright>
    <ids:version>1.0</ids:version>
    <ids:description>МОГЭ.ЦИМ.ПЗУ.3.2</ids:description>
    <ids:author>bimmoexp@gmail.com</ids:author>
    <ids:date>2026-02-02</ids:date>
    <ids:purpose>Проверка атрибутивного состава элементов по требованиям ГАУ МО "Мособлгосэкспертиза"</ids:purpose>
    <ids:milestone>Проектирование</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification ifcVersion="IFC4" name="ПЗУ.3.2.1 Земельный участок, предназначенный для размещения объекта&#xA;" identifier="3.2.1" description="Требования к ЦИМ. Раздел 3.2.1 Земельный участок, предназначенный для размещения объекта. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSITE</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:property dataType="IFCTEXT">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*(R|RA|RAA|RAB|RAC|RAD|RAE|RAF|RB|RBA|RBB|RBC|RBD|RBE|RBF|RBG|RBH|RBJ|RBK|RBL|RBM|RBN|RBP|RBQ|RBR|RBS|RBT|RC|RCA|RCB|RCC|RCD|RD|RDA|RDB|RDC|RDD|RDE|RDF|RDG|RDH|RE|REA|REB|RF|RG|RGA|RGB|RGC|RGD|RH|RJ|RJA|RJB|RJC|RJD|RJE|RJF|RJG|RJH|RJJ|RJK|RJL|RJM|RK|RKA|RKB|RKC|RKD|RKE|RKF|RKG|RKH|RKJ|RKK|RL|RLA|RLB|RM|RN|RP|RQ|RQA|RQB|RQC|RQD|RQE|RQF|RQG|RQH|RQJ|RR|RRA|RRB|RRC)\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Код класса#XNKC0001</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="R|RA|RAA|RAB|RAC|RAD|RAE|RAF|RB|RBA|RBB|RBC|RBD|RBE|RBF|RBG|RBH|RBJ|RBK|RBL|RBM|RBN|RBP|RBQ|RBR|RBS|RBT|RC|RCA|RCB|RCC|RCD|RD|RDA|RDB|RDC|RDD|RDE|RDF|RDG|RDH|RE|REA|REB|RF|RG|RGA|RGB|RGC|RGD|RH|RJ|RJA|RJB|RJC|RJD|RJE|RJF|RJG|RJH|RJJ|RJK|RJL|RJM|RK|RKA|RKB|RKC|RKD|RKE|RKF|RKG|RKH|RKJ|RKK|RL|RLA|RLB|RM|RN|RP|RQ|RQA|RQB|RQC|RQD|RQE|RQF|RQG|RQH|RQJ|RR|RRA|RRB|RRC" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Наименование класса#XNKC0002</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="Территориальные зоны|Жилая зона|Зона многоквартирной застройки|Зона застройки домами малой и средней этажности|Зона застройки блокированными домами|Зона застройки индивидуальными жилыми домами с приусадебными земельными участками|Зона \(территория\) садоводческих, дачных и огороднических кооперативов|Придомовая территория \(приватная\)|Общественно-деловая зона|Зона объекта здравоохранения|Зона объекта социального назначения|Зона объекта культуры и искусства|Зона объекта торговли|Зона объекта общественного питания|Зона объекта бытового обслуживания|Зона объекта коммерческой деятельности|Зона образовательного учреждения|Зона учреждения отдыха|Зона физкультурно-оздоровительных и спортивных сооружений|Зона административного учреждения|Зона научно-исследовательского учреждения|Зона культовых зданий|Зона центра деловой, финансовой, общественной активности|Зона стоянки автомобильного транспорта|Зона многофункциональной застройки|Зона специализированной застройки|Пассажирская зона|Производственная зона|Зона промышленного объекта|Зона коммунального объекта|Зона складского объекта|Коммунально-складская зона|Зона инженерной и транспортной инфраструктур|Зона железнодорожного транспорта|Зона автомобильного транспорта|Зона речного транспорта|Зона морского транспорта|Зона воздушного транспорта|Зона трубопроводного транспорта|Зона связи|Зона инженерных сооружений и коммуникаций|Рекреационная зона|Зона природного водного объекта|Зона ландшафтного природного объекта|Зона сельскохозяйственного использования|Зона специального назначения|Пространство кладбища|Пространство крематория|Скотомогильник|Пространство свалки бытовых отходов|Зона военных объектов|иные зоны режимных территорий|Зона с особыми условиями использования территорий|Зона охраны объектов культурного наследия|Зона особо охраняемой природной территории|Санитарно-защитная зона|Водоохранная зона \(прибрежная защитная полоса\)|Зона санитарной охраны источников водоснабжения|Приаэродромная территория|Зона охраняемого объекта|Зона залегания полезных ископаемых|Зона территории, подверженной воздействию чрезвычайных ситуаций природного и техногенного характера|Зона чрезвычайной экологической ситуации|Территория объекта культурного наследия|Курорт|Функционально-планировочные образования|Межмагистральная территория|Жилой район|Микрорайон|Квартал|Город|Cельский населенный пункт|Приграничный населенный пункт|Опорный населенный пункт|Планировочный район|Улица|Зона территории для организации мест отдыха населения|Площадь|Набережная|Строительная площадка|Прилегающая территория|Земельный участок|Природные зоны|Арктическая пустыня|Тундра|Лесотундра|Тайга|Смешанные и широколистные леса|Лесостепь|Степь|Полупустыня|Пустыня|Зона, территория, помещение или участок помещения c определенными условиями доступа|Защищаемая зона|Зона ограниченного доступа|Зона свободного доступа" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Класс строительной информации#XNKC0003</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>RZo</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Наименование</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Кадастровый номер</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCAREAMEASURE" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Геометрические параметры</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Площадь</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:double">
              <xs:minExclusive value="0" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="ПЗУ.3.2.2 Территории общего пользования&#xA;" identifier="3.2.2" description="Требования к ЦИМ. Раздел 3.2.2 Территории общего пользования. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCEXTERNALSPATIALELEMENT</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:property dataType="IFCTEXT">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*(R|RA|RAA|RAB|RAC|RAD|RAE|RAF|RB|RBA|RBB|RBC|RBD|RBE|RBF|RBG|RBH|RBJ|RBK|RBL|RBM|RBN|RBP|RBQ|RBR|RBS|RBT|RC|RCA|RCB|RCC|RCD|RD|RDA|RDB|RDC|RDD|RDE|RDF|RDG|RDH|RE|REA|REB|RF|RG|RGA|RGB|RGC|RGD|RH|RJ|RJA|RJB|RJC|RJD|RJE|RJF|RJG|RJH|RJJ|RJK|RJL|RJM|RK|RKA|RKB|RKC|RKD|RKE|RKF|RKG|RKH|RKJ|RKK|RL|RLA|RLB|RM|RN|RP|RQ|RQA|RQB|RQC|RQD|RQE|RQF|RQG|RQH|RQJ|RR|RRA|RRB|RRC)\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:applicability>
      <ids:requirements>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCEXTERNALSPATIALELEMENT</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Код класса#XNKC0001</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="R|RA|RAA|RAB|RAC|RAD|RAE|RAF|RB|RBA|RBB|RBC|RBD|RBE|RBF|RBG|RBH|RBJ|RBK|RBL|RBM|RBN|RBP|RBQ|RBR|RBS|RBT|RC|RCA|RCB|RCC|RCD|RD|RDA|RDB|RDC|RDD|RDE|RDF|RDG|RDH|RE|REA|REB|RF|RG|RGA|RGB|RGC|RGD|RH|RJ|RJA|RJB|RJC|RJD|RJE|RJF|RJG|RJH|RJJ|RJK|RJL|RJM|RK|RKA|RKB|RKC|RKD|RKE|RKF|RKG|RKH|RKJ|RKK|RL|RLA|RLB|RM|RN|RP|RQ|RQA|RQB|RQC|RQD|RQE|RQF|RQG|RQH|RQJ|RR|RRA|RRB|RRC" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Наименование класса#XNKC0002</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="Территориальные зоны|Жилая зона|Зона многоквартирной застройки|Зона застройки домами малой и средней этажности|Зона застройки блокированными домами|Зона застройки индивидуальными жилыми домами с приусадебными земельными участками|Зона \(территория\) садоводческих, дачных и огороднических кооперативов|Придомовая территория \(приватная\)|Общественно-деловая зона|Зона объекта здравоохранения|Зона объекта социального назначения|Зона объекта культуры и искусства|Зона объекта торговли|Зона объекта общественного питания|Зона объекта бытового обслуживания|Зона объекта коммерческой деятельности|Зона образовательного учреждения|Зона учреждения отдыха|Зона физкультурно-оздоровительных и спортивных сооружений|Зона административного учреждения|Зона научно-исследовательского учреждения|Зона культовых зданий|Зона центра деловой, финансовой, общественной активности|Зона стоянки автомобильного транспорта|Зона многофункциональной застройки|Зона специализированной застройки|Пассажирская зона|Производственная зона|Зона промышленного объекта|Зона коммунального объекта|Зона складского объекта|Коммунально-складская зона|Зона инженерной и транспортной инфраструктур|Зона железнодорожного транспорта|Зона автомобильного транспорта|Зона речного транспорта|Зона морского транспорта|Зона воздушного транспорта|Зона трубопроводного транспорта|Зона связи|Зона инженерных сооружений и коммуникаций|Рекреационная зона|Зона природного водного объекта|Зона ландшафтного природного объекта|Зона сельскохозяйственного использования|Зона специального назначения|Пространство кладбища|Пространство крематория|Скотомогильник|Пространство свалки бытовых отходов|Зона военных объектов|иные зоны режимных территорий|Зона с особыми условиями использования территорий|Зона охраны объектов культурного наследия|Зона особо охраняемой природной территории|Санитарно-защитная зона|Водоохранная зона \(прибрежная защитная полоса\)|Зона санитарной охраны источников водоснабжения|Приаэродромная территория|Зона охраняемого объекта|Зона залегания полезных ископаемых|Зона территории, подверженной воздействию чрезвычайных ситуаций природного и техногенного характера|Зона чрезвычайной экологической ситуации|Территория объекта культурного наследия|Курорт|Функционально-планировочные образования|Межмагистральная территория|Жилой район|Микрорайон|Квартал|Город|Cельский населенный пункт|Приграничный населенный пункт|Опорный населенный пункт|Планировочный район|Улица|Зона территории для организации мест отдыха населения|Площадь|Набережная|Строительная площадка|Прилегающая территория|Земельный участок|Природные зоны|Арктическая пустыня|Тундра|Лесотундра|Тайга|Смешанные и широколистные леса|Лесостепь|Степь|Полупустыня|Пустыня|Зона, территория, помещение или участок помещения c определенными условиями доступа|Защищаемая зона|Зона ограниченного доступа|Зона свободного доступа" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Класс строительной информации#XNKC0003</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>RZo</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Наименование</ids:simpleValue>
          </ids:baseName>
