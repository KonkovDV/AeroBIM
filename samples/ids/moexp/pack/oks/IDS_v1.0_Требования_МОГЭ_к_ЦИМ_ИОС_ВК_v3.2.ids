    <ids:specification ifcVersion="IFC4" name="ИОС.ВК.ПВ.6.4.3 Оборудование" identifier="6.4.3" description="Требования к ЦИМ. Раздел 6.4.3 Оборудование. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
