    <ids:specification ifcVersion="IFC4" name="ИОС.ВК.ПВ.6.4.2 Запорно−регулирующая арматура трубопроводов" identifier="6.4.2" description="Требования к ЦИМ. Раздел 6.4.2 Запорно−регулирующая арматура трубопроводов. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:property dataType="IFCTEXT">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
