    <ids:specification ifcVersion="IFC4" name="ИОС.ВК.ПВ.6.4.1 Трубопроводы. Изоляция трубопровода" identifier="6.4.1.3" description="Требования к ЦИМ. Раздел 6.4.1 Трубопроводы. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:property dataType="IFCTEXT">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*[Rr][Qq][Aa]\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:applicability>
