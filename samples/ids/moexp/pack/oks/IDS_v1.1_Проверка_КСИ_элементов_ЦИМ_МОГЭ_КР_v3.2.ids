<?xml version='1.0' encoding='utf-8'?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <ids:info>
    <ids:title>Требования к элементам КР ЦИМ ОКС</ids:title>
    <ids:copyright>Отдел ЦИМ, ГАУ МО "Мособлгосэкспертиза"</ids:copyright>
    <ids:version>1.1</ids:version>
    <ids:description>МОГЭ.ЦИМ.ОКС.3.2</ids:description>
    <ids:author>bimmoexp@gmail.com</ids:author>
    <ids:date>2026-03-16</ids:date>
    <ids:purpose>Проверка классификации КСИ элементов ЦИМ по требованиям ГАУ МО «Мособлгосэкспертиза»</ids:purpose>
    <ids:milestone>Проектирование</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification ifcVersion="IFC4" name="КР.5.2.1 Стены. Несущая стена" identifier="5.2.1.1" description="Требования к ЦИМ. Раздел 5.2.1 Стены. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCWALL" /><xs:enumeration value="IFCWALLTYPE" /></xs:restriction></ids:name>
        </ids:entity>
        </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Uu][Ll][Mm])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="КР.5.2.1 Стены. Проемы / отверстия" identifier="5.2.1.2" description="Требования к ЦИМ. Раздел 5.2.1 Стены. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCOPENINGELEMENT</ids:simpleValue>
          </ids:name>
        </ids:entity>
        </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Xx][Tt][Aa]|[Xx][Tt][Bb])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="КР.5.2.2 Перекрытия" identifier="5.2.2" description="Требования к ЦИМ. Раздел 5.2.2 Перекрытия. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCSLAB" /><xs:enumeration value="IFCSLABTYPE" /></xs:restriction></ids:name>
        </ids:entity>
        </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*[Uu][Ll][Kk]\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="КР.5.2.3 Колонны" identifier="5.2.3" description="Требования к ЦИМ. Раздел 5.2.3 Колонны. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCCOLUMN" /><xs:enumeration value="IFCCOLUMNTYPE" /></xs:restriction></ids:name>
        </ids:entity>
        </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT">
          <ids:propertySet>
