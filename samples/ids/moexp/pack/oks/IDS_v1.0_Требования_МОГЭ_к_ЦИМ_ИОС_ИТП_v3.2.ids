          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Расчетный расход ХВС</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
