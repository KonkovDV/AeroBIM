        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Температура на ответвлении к потребителю (Т11/Т12)</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Давление на ответвлении к потребителю (Т21/Т22)</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Температура на ответвлении к потребителю (Т21/Т22)</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Давление на ответвлении к потребителю (Т4)</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Температура на ответвлении к потребителю (Т4)</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Количество тепла на вводе в ИТП</ids:simpleValue>
