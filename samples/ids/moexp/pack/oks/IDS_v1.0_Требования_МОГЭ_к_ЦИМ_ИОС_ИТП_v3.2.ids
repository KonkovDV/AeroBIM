          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Расчетная температура ГВС</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
