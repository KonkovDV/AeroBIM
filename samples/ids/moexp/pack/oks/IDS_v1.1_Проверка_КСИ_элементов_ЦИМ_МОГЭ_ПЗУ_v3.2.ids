    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="ПЗУ.3.2.6 Въезды/выезды пожарной техники&#10;" identifier="3.2.6" description="Требования к ЦИМ. Раздел 3.2.6 Въезды/выезды пожарной техники. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCSPATIALZONE" /><xs:enumeration value="IFCSPATIALZONETYPE" /></xs:restriction></ids:name>
