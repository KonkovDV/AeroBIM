            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="ПЗУ.3.2.9 Покрытия. Слои&#10;" identifier="3.2.9.1" description="Требования к ЦИМ. Раздел 3.2.9 Покрытия. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCCIVILELEMENT" /><xs:enumeration value="IFCCOVERING" /><xs:enumeration value="IFCCIVILELEMENTTYPE" /><xs:enumeration value="IFCCOVERINGTYPE" /></xs:restriction></ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Uu][Tt][Aa]|[Rr][Qq][Hh]|[Nn][Cc][Aa]|[Uu][Ll][Aa]|[Nn][Cc][Gg]|[Ff][Ss][Kk])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="ПЗУ.3.2.9 Покрытия. Покрытия&#10;" identifier="3.2.9.2" description="Требования к ЦИМ. Раздел 3.2.9 Покрытия. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
