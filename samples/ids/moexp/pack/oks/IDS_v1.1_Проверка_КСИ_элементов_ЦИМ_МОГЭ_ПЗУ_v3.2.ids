    <ids:specification ifcVersion="IFC4" name="ПЗУ.3.2.7 Котлован&#10;" identifier="3.2.7" description="Требования к ЦИМ. Раздел 3.2.7 Котлован. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
