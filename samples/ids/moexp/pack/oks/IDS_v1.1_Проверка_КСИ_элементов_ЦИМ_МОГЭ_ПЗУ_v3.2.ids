<?xml version='1.0' encoding='utf-8'?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <ids:info>
    <ids:title>Требования к элементам ПЗУ ЦИМ ОКС</ids:title>
    <ids:copyright>Отдел ЦИМ, ГАУ МО "Мособлгосэкспертиза"</ids:copyright>
    <ids:version>1.1</ids:version>
    <ids:description>МОГЭ.ЦИМ.ПЗУ.3.2</ids:description>
    <ids:author>bimmoexp@gmail.com</ids:author>
    <ids:date>2026-03-16</ids:date>
    <ids:purpose>Проверка классификации КСИ элементов ЦИМ по требованиям ГАУ МО «Мособлгосэкспертиза»</ids:purpose>
    <ids:milestone>Проектирование</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification ifcVersion="IFC4" name="ПЗУ.3.2.1 Земельный участок, предназначенный для размещения объекта&#10;" identifier="3.2.1" description="Требования к ЦИМ. Раздел 3.2.1 Земельный участок, предназначенный для размещения объекта. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSITE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>.*[КкKk][СсCc][ИиIi].*</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>.*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="R|RA|RAA|RAB|RAC|RAD|RAE|RAF|RB|RBA|RBB|RBC|RBD|RBE|RBF|RBG|RBH|RBJ|RBK|RBL|RBM|RBN|RBP|RBQ|RBR|RBS|RBT|RC|RCA|RCB|RCC|RCD|RD|RDA|RDB|RDC|RDD|RDE|RDF|RDG|RDH|RE|REA|REB|RF|RG|RGA|RGB|RGC|RGD|RH|RJ|RJA|RJB|RJC|RJD|RJE|RJF|RJG|RJH|RJJ|RJK|RJL|RJM|RK|RKA|RKB|RKC|RKD|RKE|RKF|RKG|RKH|RKJ|RKK|RL|RLA|RLB|RM|RN|RP|RQ|RQA|RQB|RQC|RQD|RQE|RQF|RQG|RQH|RQJ|RR|RRA|RRB|RRC" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="ПЗУ.3.2.2 Территории общего пользования&#10;" identifier="3.2.2" description="Требования к ЦИМ. Раздел 3.2.2 Территории общего пользования. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCEXTERNALSPATIALELEMENT</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*(R|RA|RAA|RAB|RAC|RAD|RAE|RAF|RB|RBA|RBB|RBC|RBD|RBE|RBF|RBG|RBH|RBJ|RBK|RBL|RBM|RBN|RBP|RBQ|RBR|RBS|RBT|RC|RCA|RCB|RCC|RCD|RD|RDA|RDB|RDC|RDD|RDE|RDF|RDG|RDH|RE|REA|REB|RF|RG|RGA|RGB|RGC|RGD|RH|RJ|RJA|RJB|RJC|RJD|RJE|RJF|RJG|RJH|RJJ|RJK|RJL|RJM|RK|RKA|RKB|RKC|RKD|RKE|RKF|RKG|RKH|RKJ|RKK|RL|RLA|RLB|RM|RN|RP|RQ|RQA|RQB|RQC|RQD|RQE|RQF|RQG|RQH|RQJ|RR|RRA|RRB|RRC)\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="ПЗУ.3.2.3 Зоны действия публичных сервитутов&#10;" identifier="3.2.3" description="Требования к ЦИМ. Раздел 3.2.3 Зоны действия публичных сервитутов. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCEXTERNALSPATIALELEMENT</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*R[AaАа][A-Za-zА-Яа-я0-9]{2}\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="ПЗУ.3.2.4 Функциональные зоны/площадки&#10;" identifier="3.2.4" description="Требования к ЦИМ. Раздел 3.2.4 Функциональные зоны/площадки. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCSPATIALZONE" /><xs:enumeration value="IFCSPATIALZONETYPE" /></xs:restriction></ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Ff][Aa][Dd]|[Cc][Bb][Dd]|[Bb][Dd][Ff]|[Bb][Dd][Ee]|[Bb][Ee][Bb]|[Aa][Aa][Bb]|[Cc][Aa][Aa]|[Cc][Aa][Nn]|[Cc][Bb][Bb]|[Cc][Dd][Bb]|[Bb][Aa][Ee])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="ПЗУ.3.2.4 Функциональные зоны/площадки. Зона движения транспорта и пешеходов.&#10;" identifier="3.2.4" description="Требования к ЦИМ. Раздел 3.2.4 Функциональные зоны/площадки. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCSPATIALZONE" /><xs:enumeration value="IFCSPATIALZONETYPE" /></xs:restriction></ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Ff][Ff][Dd]|[Ee][Aa][Dd]|[Ff][Dd][Bb]|[Ff][Bb][Bb]|[Ff][Bb][Aa])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="ПЗУ.3.2.4 Функциональные зоны/площадки. Парковочное место&#10;" identifier="3.2.4" description="Требования к ЦИМ. Раздел 3.2.4 Функциональные зоны/площадки. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCSPATIALZONE" /><xs:enumeration value="IFCSPATIALZONETYPE" /></xs:restriction></ids:name>
        </ids:entity>
      </ids:applicability>
