    <ids:specification ifcVersion="IFC4" name="ПЗУ.3.2.10 Бортовые камни и водоотводные лотки" identifier="3.2.10" description="Требования к ЦИМ. Раздел 3.2.10 Бортовые камни и водоотводные лотки. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCCIVILELEMENT" /><xs:enumeration value="IFCCIVILELEMENTTYPE" /></xs:restriction></ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Nn][Dd][Aa]|[Ww][Mm][Bb])\s*.*" />
            </xs:restriction>
          </ids:value>
