    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="ПЗУ.3.2.8 Земляные работы&#10;" identifier="3.2.8" description="Требования к ЦИМ. Раздел 3.2.8 Земляные работы. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
