<ids:ids xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd" xmlns:ids="http://standards.buildingsmart.org/IDS">
  <ids:info>
    <ids:title>Требования к элементам ИОС ОВиК ЦИМ ОКС</ids:title>
    <ids:copyright>Отдел ЦИМ, ГАУ МО "Мособлгосэкспертиза"</ids:copyright>
    <ids:version>1.0</ids:version>
    <ids:description>МОГЭ.ЦИМ.ИОС.ОВиК.3.2</ids:description>
    <ids:author>bimmoexp@gmail.com</ids:author>
    <ids:date>2026-02-02</ids:date>
    <ids:purpose>Проверка атрибутивного состава элементов по требованиям ГАУ МО "Мособлгосэкспертиза"</ids:purpose>
    <ids:milestone>Проектирование</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification ifcVersion="IFC4" name="ИОС.ОВиК.6.5.1 Трубопроводы. Трубы" identifier="6.5.1.1" description="Требования к ЦИМ. Раздел 6.5.1 Трубопроводы. Трубы и соединительные детали. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:property dataType="IFCTEXT">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Ww][Pp][Aa]|[Ww][Pp][Cc])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:applicability>
      <ids:requirements>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCPIPESEGMENT</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Код класса#XNKC0001</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="WPA" />
              <xs:enumeration value="WPC" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Наименование класса#XNKC0002</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="труба" />
              <xs:enumeration value="шланг" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Класс строительной информации#XNKC0003</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>Com</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCLENGTHMEASURE" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Геометрические параметры</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Длина</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Геометрические параметры</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Диаметр условного прохода</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Тип системы</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Имя системы</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Наименование</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Обозначение</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Способ соединения</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Муфтовое" />
              <xs:enumeration value="Фланцевое" />
              <xs:enumeration value="Сварка (склейка)" />
              <xs:enumeration value="Раструбное" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Строительные параметры</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Материал</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="ИОС.ОВиК.6.5.1 Трубопроводы. Соединительные детали" identifier="6.5.1.2" description="Требования к ЦИМ. Раздел 6.5.1 Трубопроводы. Трубы и соединительные детали. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:property dataType="IFCTEXT">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Xx][Mm][Bb])\s*.*" />
