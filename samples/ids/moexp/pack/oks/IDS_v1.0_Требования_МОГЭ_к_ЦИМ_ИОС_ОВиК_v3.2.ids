          </ids:baseName>
          <ids:value>
            <ids:simpleValue>RQA</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
