<ids:ids xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd" xmlns:ids="http://standards.buildingsmart.org/IDS">
  <ids:info>
    <ids:title>Требования к элементам ИОС СС ЦИМ ОКС</ids:title>
    <ids:copyright>Отдел ЦИМ, ГАУ МО "Мособлгосэкспертиза"</ids:copyright>
    <ids:version>1.0</ids:version>
    <ids:description>МОГЭ.ЦИМ.ИОС.СС.3.2</ids:description>
    <ids:author>bimmoexp@gmail.com</ids:author>
    <ids:date>2026-02-02</ids:date>
    <ids:purpose>Проверка атрибутивного состава элементов по требованиям ГАУ МО "Мособлгосэкспертиза"</ids:purpose>
    <ids:milestone>Проектирование</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification ifcVersion="IFC4" name="ИОС.СС.6.6.1 Кабельные лотки, короба, шинопроводы, кабель" identifier="6.6.1" description="Требования к ЦИМ. Раздел 6.6.1 Кабельные лотки, короба, шинопроводы, кабель. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:property dataType="IFCTEXT">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Uu][Bb][Aa]|[Ww][Dd][Aa]|[Ww][Dd][Bb]|[Ww][Dd][Cc]|[Ww][Hh][Aa])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:applicability>
      <ids:requirements>
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:pattern value="IFCCABLECARRIERSEGMENT|IFCCABLESEGMENT" />
            </xs:restriction>
          </ids:name>
        </ids:entity>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Код класса#XNKC0001</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="UBA" />
              <xs:enumeration value="WDA" />
              <xs:enumeration value="WDB" />
              <xs:enumeration value="WDC" />
              <xs:enumeration value="WHA" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Наименование класса#XNKC0002</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="несущий лоток (короб)" />
              <xs:enumeration value="низковольтная шина" />
              <xs:enumeration value="низковольтный кабель" />
              <xs:enumeration value="низковольтный провод" />
              <xs:enumeration value="волоконно-оптический кабель" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Класс строительной информации#XNKC0003</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>Com</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCLENGTHMEASURE" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Геометрические параметры</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Длина</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLENGTHMEASURE" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Геометрические параметры</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Высота</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLENGTHMEASURE" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Геометрические параметры</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Ширина</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Наименование</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Обозначение</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Строительные параметры</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Материал</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="ИОС.СС.6.6.2 Оборудование" identifier="6.6.2" description="Требования к ЦИМ. Раздел 6.6.2 Оборудование. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:property dataType="IFCTEXT">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Pp][Zz][Aa]|[Bb][Uu][Aa]|[Ff][Qq][Jj]|[Kk][Ee][Bb]|[Kk][Ee][Dd])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:applicability>
      <ids:requirements>
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:pattern value="IFCALARM|IFCSENSOR|IFCACTUATOR|IFCCONTROLLER|IFCELECTRICAPPLIANCE|IFCCOMMUNICATIONSAPPLIANCE" />
            </xs:restriction>
          </ids:name>
        </ids:entity>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Код класса#XNKC0001</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="PZA" />
              <xs:enumeration value="BUA" />
              <xs:enumeration value="FQJ" />
              <xs:enumeration value="KEB" />
              <xs:enumeration value="KED" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Наименование класса#XNKC0002</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="аудиовизуальная сигнализация" />
              <xs:enumeration value="многосенсорное измерительное устройство" />
              <xs:enumeration value="запирающий механизм" />
              <xs:enumeration value="блок управления" />
              <xs:enumeration value="маршрутизатор" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Класс строительной информации#XNKC0003</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>Com</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Наименование</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Обозначение</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="ИОС.СС.6.6.3 Шкафы, ящики и коробки" identifier="6.6.3" description="Требования к ЦИМ. Раздел 6.6.3 Шкафы, ящики и коробки. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:property dataType="IFCTEXT">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Xx][Dd][Cc]|[Qq][Aa][Ee])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:applicability>
      <ids:requirements>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCELECTRICDISTRIBUTIONBOARD</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Код класса#XNKC0001</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="XDC" />
              <xs:enumeration value="QAE" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Наименование класса#XNKC0002</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="распределительная коробка" />
              <xs:enumeration value="распределительный щит" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Класс строительной информации#XNKC0003</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>Com</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Наименование</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Обозначение</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
  </ids:specifications>
</ids:ids>