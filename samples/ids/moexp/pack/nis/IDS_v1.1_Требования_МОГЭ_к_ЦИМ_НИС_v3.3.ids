        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Строительные параметры</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value="A\d{3}C?_(80|[1-7]\d|\d)" />
            </xs:restriction>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="2.1.27 Гидро- и пароизоляция. Основные атрибуты" identifier="2.1.27.1" description="Требования к ЦИМ. Раздел 2.1.27 Гидро- и пароизоляция. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC" instructions="Особенности моделирования:&#xA;допускается не моделировать элемент гидроизоляции в случае, если дополнить атрибутивный&#xA;состав элемента, к которому применяется гидроизоляция, дополнительными атрибутами (см.&#xA;Таблица 2.60)">
