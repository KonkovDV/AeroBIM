    <ids:specification ifcVersion="IFC4" name="2.1..6 Измерительные приборы" identifier="3.2.6" description="Требования к ЦИМ. Раздел 3.2.6 Измерительные приборы. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC" instructions="Особенности моделирования:&#xA;измерительные приборы моделируются в виде упрощенных объемных элементов габаритами,&#xA;соответствующим реальными размерам;&#xA;измерительные приборы внутри колодцев, камер и коверов моделируется">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:property>
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Bb][Aa][Aa]|[Bb][Aa][Bb]|[Bb][Bb][Aa]|[Bb][Bb][Bb]|[Bb][Bb][Cc]|[Bb][Bb][Dd]|[Bb][Cc][Aa]|[Bb][Cc][Bb]|[Bb][Dd][Aa]|[Bb][Dd][Bb]|[Bb][Ee][Aa]|[Bb][Ee][Bb]|[Bb][Ee][Cc]|[Bb][Ee][Dd]|[Bb][Ff][Aa]|[Bb][Ff][Bb]|[Bb][Ff][Cc]|[Bb][Ff][Dd]|[Bb][Gg][Aa]|[Bb][Gg][Bb]|[Bb][Gg][Cc]|[Bb][Gg][Dd]|[Bb][Gg][Ee]|[Bb][Gg][Ff]|[Bb][Gg][Gg]|[Bb][Gg][Hh]|[Bb][Hh][Aa]|[Bb][Hh][Bb]|[Bb][Hh][Cc]|[Bb][Jj][Aa]|[Bb][Jj][Bb]|[Bb][Kk][Aa]|[Bb][Kk][Bb]|[Bb][Ll][Aa]|[Bb][Ll][Bb]|[Bb][Mm][Aa]|[Bb][Mm][Bb]|[Bb][Pp][Aa]|[Bb][Pp][Bb]|[Bb][Pp][Cc]|[Bb][Pp][Dd]|[Bb][Qq][Aa]|[Bb][Qq][Bb]|[Bb][Qq][Cc]|[Bb][Qq][Dd]|[Bb][Qq][Ee]|[Bb][Qq][Ff]|[Bb][Rr][Aa]|[Bb][Rr][Bb]|[Bb][Rr][Cc]|[Bb][Rr][Dd]|[Bb][Rr][Ee]|[Bb][Rr][Ff]|[Bb][Ss][Aa]|[Bb][Ss][Bb]|[Bb][Ss][Cc]|[Bb][Ss][Dd]|[Bb][Ss][Ee]|[Bb][Ss][Ff]|[Bb][Ss][Gg]|[Bb][Ss][Hh]|[Bb][Tt][Aa]|[Bb][Tt][Bb]|[Bb][Uu][Aa]|[Bb][Uu][Bb]|[Bb][Ww][Aa]|[Bb][Ww][Bb]|[Bb][Ww][Cc]|[Bb][Ww][Dd]|[Bb][Ww][Ee]|[Bb][Ww][Ff]|[Bb][Xx][Aa]|[Bb][Xx][Bb]|[Bb][Xx][Cc]|[Bb][Xx][Dd]|[Bb][Yy][Aa]|[Bb][Yy][Bb]|[Bb][Yy][Cc]|[Bb][Zz][Aa]|[Bb][Zz][Bb]|[Bb][Zz][Cc]|[Bb][Zz][Dd]|[Bb][Zz][Ee])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:applicability>
      <ids:requirements>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCFLOWINSTRUMENT</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Код класса#XNKC0001</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="BAA|BAB|BBA|BBB|BBC|BBD|BCA|BCB|BDA|BDB|BEA|BEB|BEC|BED|BFA|BFB|BFC|BFD|BGA|BGB|BGC|BGD|BGE|BGF|BGG|BGH|BHA|BHB|BHC|BJA|BJB|BKA|BKB|BLA|BLB|BMA|BMB|BPA|BPB|BPC|BPD|BQA|BQB|BQC|BQD|BQE|BQF|BRA|BRB|BRC|BRD|BRE|BRF|BSA|BSB|BSC|BSD|BSE|BSF|BSG|BSH|BTA|BTB|BUA|BUB|BWA|BWB|BWC|BWD|BWE|BWF|BXA|BXB|BXC|BXD|BYA|BYB|BYC|BZA|BZB|BZC|BZD|BZE" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
