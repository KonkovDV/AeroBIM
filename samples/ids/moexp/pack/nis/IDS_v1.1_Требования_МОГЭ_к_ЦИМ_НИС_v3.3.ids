    <ids:specification ifcVersion="IFC4" name="2.1.3 Футляры и каналы (Прямоугольного сечения)" identifier="2.1.3.9" description="Требования к ЦИМ. Раздел 2.1.3 Трубы, футляры, каналы и соединительные детали. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC" instructions="Особенности моделирования:&#xA;изоляция и трубы моделируются в виде отдельных элементов, объединенных в сборку (с помощью IfcRelAggregates)">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:property>
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
