    <ids:specification ifcVersion="IFC4" name="2.1.5 Запорно-регулирующая арматура" identifier="2.1.5" description="Требования к ЦИМ. Раздел 2.1.5 Запорно-регулирующая арматура. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC&#xA;" instructions="Особенности моделирования:&#xA;запорно-регулирующая арматура моделируется в виде упрощенных объемных элементов&#xA;габаритами, соответствующим реальными размерам в положении полного открытия;&#xA;запорно-регулирующая внутри колодцев и камер моделируется.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:property>
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Qq][Mm][Aa]|[Qq][Mm][Bb])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:applicability>
      <ids:requirements>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCVALVE</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Код класса#XNKC0001</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="QMA" />
              <xs:enumeration value="QMB" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Наименование класса#XNKC0002</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="жидкостный запорный клапан" />
              <xs:enumeration value="газовый запорный клапан" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Класс строительной информации#XNKC0003</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>Com</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property cardinality="required">
