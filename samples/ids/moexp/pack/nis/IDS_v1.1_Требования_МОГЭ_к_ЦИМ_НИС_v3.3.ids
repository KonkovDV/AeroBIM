    <ids:specification ifcVersion="IFC4" name="2.1.10 Опоры трубопроводов" identifier="2.1.10" description="Требования к ЦИМ. Раздел 2.1.10 Опоры трубопроводов. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC&#xA;" instructions="Особенности моделирования:&#xA;требования данного раздела распространяются на опоры трубопроводов вне эстакад и галерей;&#xA; опоры трубопроводов моделируются единым элементом либо в виде отдельных блоков,&#xA;объединенных в сборку (с помощью IfcRelAggregates);&#xA;требования к моделированию составных элементов опор приведены в соответствующих разделах.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:property>
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Bb][Hh])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:applicability>
      <ids:requirements>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCFOOTING</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Код класса#XNKC0001</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>BH</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Наименование класса#XNKC0002</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>Направляющие и опорные конструкции</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Класс строительной информации#XNKC0003</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>TeS</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Наименование</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Обозначение</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Геометрические параметры</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Высота</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Геометрические параметры</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Длина</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Геометрические параметры</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Ширина</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
