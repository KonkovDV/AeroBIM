              <xs:pattern value=".*\s*([Uu][Ll][Dd]|[Uu][Ll][Ee]|[Uu][Ll][Kk]|[Uu][Mm][Ll]|[Xx][Ss][Cc]|[Rr][Uu][Aa])\s*.*" />
