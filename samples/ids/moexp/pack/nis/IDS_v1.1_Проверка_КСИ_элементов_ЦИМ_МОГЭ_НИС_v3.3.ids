    <ids:specification ifcVersion="IFC4" name="2.1.2 Трубопроводные сети (IfcSystem) (Теплоснабжение)" identifier="2.1.2.4" description="Требования к ЦИМ. Раздел 2.1.2 Системы. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSYSTEM</ids:simpleValue>
