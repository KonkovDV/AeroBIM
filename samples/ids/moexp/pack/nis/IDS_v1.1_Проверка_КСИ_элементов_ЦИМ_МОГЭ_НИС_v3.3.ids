    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="2.1.2 Трубопроводные сети (IfcSystem) (Системы связи)" identifier="2.1.2.3" description="Требования к ЦИМ. Раздел 2.1.2 Системы. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSYSTEM</ids:simpleValue>
          </ids:name>
        </ids:entity>
        </ids:applicability>
      <ids:requirements>
        <ids:property>
          <ids:propertySet>
            <xs:restriction base="xs:string">
