            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Uu][Ll][Mm])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="2.1.23 Железобетонные стены. Отверстия" identifier="2.1.23.1" description="Требования к ЦИМ. Раздел 2.1.23 Железобетонные стены. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCOPENINGELEMENT</ids:simpleValue>
          </ids:name>
        </ids:entity>
        </ids:applicability>
      <ids:requirements>
        <ids:property>
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Xx][Tt][Aa]|[Xx][Tt][Bb])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="2.1.24 Железобетонные перекрытия" identifier="2.1.24" description="Требования к ЦИМ. Раздел 2.1.24 Железобетонные перекрытия. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCSLAB" /><xs:enumeration value="IFCSLABTYPE" /></xs:restriction></ids:name>
        </ids:entity>
        </ids:applicability>
      <ids:requirements>
        <ids:property>
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Uu][Ll][Kk])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="2.1.25 Кровля. Общая сборка" identifier="2.1.25.1" description="Требования к ЦИМ. Раздел 2.1.25 Кровля. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC" instructions="Особенности моделирования:&#10;кровельное покрытие моделируется в виде отдельных элементов, объединенных в сборку (с&#10;помощью IfcRelAggregates). Требования к моделированию отдельных элементов приведены в&#10;соответствующих разделах.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCROOF" /><xs:enumeration value="IFCROOFTYPE" /></xs:restriction></ids:name>
        </ids:entity>
        </ids:applicability>
      <ids:requirements>
        <ids:property>
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*[Aa][Ee]\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="2.1.25 Кровля. Элементы сборки" identifier="2.1.25.2" description="Требования к ЦИМ. Раздел 2.1.25 Кровля. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC" instructions="Особенности моделирования:&#10;кровельное покрытие моделируется в виде отдельных элементов, объединенных в сборку (с&#10;помощью IfcRelAggregates). Требования к моделированию отдельных элементов приведены в&#10;соответствующих разделах.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCCOVERING" /><xs:enumeration value="IFCCOVERINGTYPE" /></xs:restriction></ids:name>
        </ids:entity>
        </ids:applicability>
      <ids:requirements>
        <ids:property>
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*[Nn][Cc][Ee]\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="2.1.26 Подпорные стены" identifier="2.1.26" description="Требования к ЦИМ. Раздел 2.1.26 Подпорные стены. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC" instructions="Особенности моделирования:&#10;подпорные стены моделируются единым элементом либо в виде отдельных блоков,&#10;объединенных в сборку (с помощью IfcRelAggregates);&#10;требования к моделированию составных элементов подпорных стен приведены в&#10;соответствующих разделах">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCWALL" /><xs:enumeration value="IFCWALLTYPE" /></xs:restriction></ids:name>
        </ids:entity>
        </ids:applicability>
      <ids:requirements>
        <ids:property>
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Uu][Ll][Ll])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="2.1.27 Гидро- и пароизоляция. Основные атрибуты" identifier="2.1.27.1" description="Требования к ЦИМ. Раздел 2.1.27 Гидро- и пароизоляция. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC" instructions="Особенности моделирования:&#10;допускается не моделировать элемент гидроизоляции в случае, если дополнить атрибутивный&#10;состав элемента, к которому применяется гидроизоляция, дополнительными атрибутами (см.&#10;Таблица 2.60)">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string"><xs:enumeration value="IFCCOVERING" /><xs:enumeration value="IFCCOVERINGTYPE" /></xs:restriction></ids:name>
        </ids:entity>
        </ids:applicability>
      <ids:requirements>
        <ids:property>
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Rr][Qq][Bb])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
  </ids:specifications>
</ids:ids>