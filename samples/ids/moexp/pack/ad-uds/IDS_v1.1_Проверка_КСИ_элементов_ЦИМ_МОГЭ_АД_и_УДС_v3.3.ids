          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="2.1.26 Подпорные стены" identifier="2.1.26" description="Требования к ЦИМ. Раздел 2.1.26 Подпорные стены. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC" instructions="Особенности моделирования:&#10;грунт засыпки армогрунтовых систем моделируется отдельным элементом в соответствии с&#10;разделом 2.1.8.">
