    <ids:specification ifcVersion="IFC4" name="2.1.23 Водопропускная труба" identifier="2.1.23" description="Требования к ЦИМ. Раздел 2.1.23 Водопропускная труба. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC" instructions="Особенности моделирования:&#xA;каждая труба многоочковых водопропускных труб моделируется отдельным элементом;&#xA;водопропускные трубы моделируется с проектным уклоном без учета строительного подъема;&#xA;металлические гофрированные трубы моделируются в виде труб с толщиной стенки, равной&#xA;высоте гофра плюс толщина листа.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:property>
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
