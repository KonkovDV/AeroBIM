          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Код класса#XNKC0001</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>FQD</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property cardinality="required">
