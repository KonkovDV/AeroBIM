    <ids:specification ifcVersion="IFC4" name="2.1.22 Лестничные сходы, пандусы. Общая сборка" identifier="2.1.22.1" description="Требования к ЦИМ. Раздел 2.1.22 Лестничные сходы, пандусы. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC" instructions="Особенности моделирования:&#xA;лестничные сходы должны иметь правильные габариты, форму и отражать проектное количество&#xA;проступей и площадок;&#xA;пандусы должны иметь правильные габариты форму и уклон.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:property>
          <ids:propertySet>
            <ids:simpleValue>.*[КкKk][СсCc][ИиIi].*</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>.*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Xx][Ss][Cc]|[Xx][Ss][Dd])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:applicability>
      <ids:requirements>
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCSTAIR" />
              <xs:enumeration value="IFCRAMP" />
            </xs:restriction>
          </ids:name>
        </ids:entity>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Код класса#XNKC0001</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="XSC" />
              <xs:enumeration value="XSD" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Наименование класса#XNKC0002</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="лестница" />
              <xs:enumeration value="пандус" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Класс строительной информации#XNKC0003</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>Com</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Обозначение</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Наименование</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Информация</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Марка</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Геометрические параметры</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Высота</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Геометрические параметры</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Ширина</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Геометрические параметры</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Высота</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Строительные параметры</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Материал</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_Строительные параметры</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value="A\d{3}C?_(80|[1-7]\d|\d)" />
            </xs:restriction>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4" name="2.1.22 Лестничные сходы, пандусы. Элементы сборки" identifier="2.1.22.2" description="Требования к ЦИМ. Раздел 2.1.22 Лестничные сходы, пандусы. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC" instructions="Особенности моделирования:&#xA;лестничные сходы должны иметь правильные габариты, форму и отражать проектное количество&#xA;проступей и площадок;&#xA;пандусы должны иметь правильные габариты форму и уклон.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:partOf relation="IFCRELAGGREGATES">
          <ids:entity>
            <ids:name>
              <xs:restriction base="xs:string">
                <xs:enumeration value="IFCSTAIR" />
                <xs:enumeration value="IFCRAMP" />
              </xs:restriction>
            </ids:name>
          </ids:entity>
        </ids:partOf>
        <ids:property>
          <ids:propertySet>
            <ids:simpleValue>.*[КкKk][СсCc][ИиIi].*</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>.*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Xx][Ss][Bb]|[Xx][Ss][Aa]|[Uu][Aa][Dd]|[Uu][Bb][Cc])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
