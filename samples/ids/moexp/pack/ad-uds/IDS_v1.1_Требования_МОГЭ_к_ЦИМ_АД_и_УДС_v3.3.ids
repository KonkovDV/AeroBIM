          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="UMJ" />
              <xs:enumeration value="NCG" />
              <xs:enumeration value="UMC" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
