    <ids:specification ifcVersion="IFC4" name="2.1.5 Ригели, насадки" identifier="2.1.5" description="Требования к ЦИМ. Раздел 2.1.5 Ригели, насадки. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:property>
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
