          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Наименование класса#XNKC0002</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="лестничный пролет" />
              <xs:enumeration value="лестничная площадка" />
              <xs:enumeration value="косоур" />
              <xs:enumeration value="ступень" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>МОГЭ_КСИ</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>КСИ Класс строительной информации#XNKC0003</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>Com</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property cardinality="required">
