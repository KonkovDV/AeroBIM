    <ids:specification ifcVersion="IFC4" name="2.1.9 Укрепления грунтовых поверхностей" identifier="2.1.9" description="Требования к ЦИМ. Раздел 2.1.9 Укрепления грунтовых поверхностей. Наименование и описание атрибутов, экспортируемых в ЦИМ формата IFC" instructions="Особенности моделирования:&#xA;Подготовка под укрепление из сыпучих материалов моделируется отдельным элементом в&#xA;соответствии с разделом 2.1.8.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:property>
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*[КкKk][СсCc][ИиIi].*" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*([КкKk][СсCc][ИиIi]).*([КкKk][ОоOo][ДдDd]).*([КкKk][ЛлLl][АаAa][СсCc][СсCc][АаAa].*).*" />
            </xs:restriction>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\s*([Uu][Mm][Jj]|[Nn][Cc][Gg]|[Uu][Mm][Cc])\s*.*" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:applicability>
      <ids:requirements>
        <ids:entity>
