# AeroBIM — Demo Environment Template
# Скопируйте в .env.demo.local и отредактируйте. .env.demo.local — в .gitignore.
#
# Используется docker-compose.demo.yml и deploy/demo/setup-demo.*
# Inline-defaults в docker-compose.demo.yml достаточны для localhost-демо.

# ── Режим демо ────────────────────────────────────────────────────────────
# customer_pilot_demo — честный скоп (clash/MEP = SKIPPED, не подделывает)
# moscow_agr_2026     — то же + ссылка на ПП Москвы № 17-ПП / ДГП-Р-1/26
AEROBIM_SIGNOFF_PROFILE=customer_pilot_demo
AEROBIM_ENV=development

# ── Анонимный API (только development) ────────────────────────────────────
# Для демо без пароля. Замените на токен, если нужна защита.
AEROBIM_ALLOW_ANONYMOUS_DEV=true
# AEROBIM_API_BEARER_TOKEN=replace-with-a-random-32-char-secret

# ── Сеть ──────────────────────────────────────────────────────────────────
# Анонимный API остаётся на петле. В локальную сеть его не публикуем.
AEROBIM_HOST=127.0.0.1
AEROBIM_PORT=8080
AEROBIM_DEBUG=false

# ── CORS ─────────────────────────────────────────────────────────────────
# Оболочка — Vite на 5173.
AEROBIM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Хранение отчётов ──────────────────────────────────────────────────────
AEROBIM_STORAGE_DIR=var/reports

# ── PDF backend ─────────────────────────────────────────────────────────
AEROBIM_PDF_BACKEND=pdfium

# ── Язык замечаний ──────────────────────────────────────────────────────
AEROBIM_REMARK_LOCALE=ru

# ── LLM/VLM: выключены на демо ──────────────────────────────────────────
AEROBIM_LLM_ADVISORY_ENABLED=false
AEROBIM_VLM_ENABLED=false
AEROBIM_CUSTOMER_PACK_LLM_EGRESS=deny

# ── Redis (опционально, для production-like demo) ─────────────────────────────
# Для localhost-демо без Redis — не задавайте.
# AEROBIM_REDIS_URL=redis://127.0.0.1:6379/0

# ── S3/MinIO (опционально) ───────────────────────────────────────────────
# AEROBIM_S3_BUCKET=aerobim-demo
# AEROBIM_S3_ENDPOINT_URL=http://127.0.0.1:9000
# AEROBIM_S3_ACCESS_KEY_ID=minioadmin
# AEROBIM_S3_SECRET_ACCESS_KEY=minioadmin
